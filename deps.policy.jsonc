// Dependency policy for the Lockness monorepo — the hand-written INPUT.
//
// `docs/dependencies.md` is the generated OUTPUT; do not edit that file.
// `deno task deps:analyze` checks the real module graph against this one and
// fails on any edge that is not permitted here.
//
// `allow` — the exhaustive set of STATIC edges a package may have. Measured
//   from `deno info`, so it covers value imports, type imports, aliased
//   specifiers (`"hono": "jsr:@lockness/hono"`) and literal dynamic imports.
//
// `soft`  — the exhaustive set of OPTIONAL packages loaded at runtime through
//   `tryImportOptionalPackage('<name>', …)`. The specifier is a string
//   ARGUMENT, so it appears in no module graph and no static tool can see it.
//   Declaring it here is the only way it is checked at all. A soft edge is
//   deliberately NOT declared in the package's own `deno.json`: the consuming
//   application installs it, or the feature stays off.
//
// `runtimeImports` — the exhaustive inventory of sites `deno publish` names
//   unanalysable: a non-literal `import(spec)` or `import.meta.resolve(spec)`.
//   No graph sees them, so they cannot be declared. Per file, the site
//   count and the reason it must stay computed. `deno task publish:check`
//   compares it with the workspace dry-run and fails on any drift (#463).
//
// Widening this file is a `chore(deps)` commit of its own — never bundled with
// the change that needed the widening.
{
    // Cycles that already existed when the guard was introduced. Each needs a
    // ticket, and removing the entry is what closes it. A NEW cycle fails the
    // build — adding it here to go green is explicitly not the remedy.
    "knownCycles": [],
    "tiers": {
        "foundation": 0,
        "implementation": 1,
        "orchestration": 2
    },
    "packages": {
        // ---- Foundation: imported by everything, importing (almost) nothing.
        // NOTE: `contract` is not dependency-free — it takes Hono's types
        // through the `hono` alias. Every such import is `import type`, so the
        // edge erases at runtime, but it is a real edge and is declared.
        "hono": { "tier": "foundation", "allow": [] },
        "contract": { "tier": "foundation", "allow": ["hono"] },
        "container": { "tier": "foundation", "allow": ["contract"] },
        "redis": { "tier": "foundation", "allow": ["contract"] },
        "crypto": { "tier": "foundation", "allow": ["contract"] },

        // ---- Implementation
        "auth": {
            "tier": "implementation",
            "allow": ["contract", "crypto", "events", "hono", "session"]
        },
        "auth-provider": { "tier": "implementation", "allow": ["auth"] },
        "cache": {
            "tier": "implementation",
            "allow": ["container", "contract"]
        },
        "cli": {
            "tier": "implementation",
            "allow": ["contract", "queue", "events"],
            "runtimeImports": {
                "commands/queue_commands.ts": {
                    "sites": 1,
                    "reason": "queue:work loads each job file found in the user app's app/job at runtime"
                },
                "commands/router_commands.ts": {
                    "sites": 1,
                    "reason": "router:list loads each controller file found in the user app's app/controller"
                },
                "commands/tinker_command.ts": {
                    "sites": 2,
                    "reason": "tinker loads the user app's model, service and repository files, then its app/kernel.ts, into the REPL"
                },
                "core_commands.ts": {
                    "sites": 1,
                    "reason": "package:install loads <package>/install for a package name the user types"
                },
                "mod.ts": {
                    "sites": 1,
                    "reason": "Cli.discoverCommands loads each *_command file of a directory the caller names"
                },
                "package_loader.ts": {
                    "sites": 1,
                    "reason": "loads each package named in the user app's lockness.packages config; the app installs it"
                }
            }
        },
        "deprecation-contracts": { "tier": "implementation", "allow": [] },
        "devtools": {
            "tier": "implementation",
            "allow": ["hono", "contract", "events", "session"]
        },
        "drizzle": {
            "tier": "implementation",
            "allow": ["cli", "container", "contract"],
            "runtimeImports": {
                "migration_settings.ts": {
                    "sites": 1,
                    "reason": "loads the user app's drizzle.config.ts from the working directory, the file drizzle-kit reads"
                }
            }
        },
        "events": { "tier": "implementation", "allow": ["contract", "hono"] },
        // `features` and `search` are pure-logic sinks: flag resolution /
        // tokenised inverted index, no workspace deps (scope + documents are
        // app-supplied data). Nothing imports them.
        "features": { "tier": "implementation", "allow": [] },
        "search": { "tier": "implementation", "allow": [] },
        // `i18n` is a near-pure sink: core soft-loads it at boot, and it imports
        // only hono (Context/cookie/header helpers; the resolver logs nothing,
        // so it needs no contract safeForLog). Zero message-format dependency —
        // ICU plurals run on Deno's built-in Intl.PluralRules.
        "i18n": { "tier": "implementation", "allow": ["hono"] },
        "inertia": { "tier": "implementation", "allow": ["hono"] },
        "init": { "tier": "implementation", "allow": ["cli"] },
        "logger": { "tier": "implementation", "allow": ["contract"] },
        // `mail` stays zero-hard-dep (`allow: []`). Markdown mailables + queued
        // mail load their backing only when used, through mail's OWN local
        // `tryImport` (packages/mail/optional.ts) — a soft edge, never a value
        // or `import type` of markdown/queue (either would harden it).
        "mail": {
            "tier": "implementation",
            "allow": [],
            "soft": ["markdown", "queue"],
            "runtimeImports": {
                "optional.ts": {
                    "sites": 1,
                    "reason": "tryImport's default importer loads the soft markdown or queue backing; a variable keeps the edge soft"
                }
            }
        },
        "markdown": { "tier": "implementation", "allow": ["hono"] },
        // `notification` is a pure sink: nothing imports it, so it cannot close
        // a cycle. Its channel backing packages are declared `soft` — each is
        // loaded on demand through one variable-specifier `tryImport`, so a
        // log-only app pulls none of mail/queue/sse/drizzle. A static or
        // `import type` from any of them would harden the edge and fail checks
        // B+C — that is the invariant FR-004 + the §5 decision-table row protect.
        "notification": {
            "tier": "implementation",
            "allow": ["contract", "container"],
            "soft": ["mail", "queue", "logger", "sse", "drizzle"],
            "runtimeImports": {
                "optional.ts": {
                    "sites": 1,
                    "reason": "tryImport's default importer loads a soft channel backing package; a variable keeps the edge soft"
                }
            }
        },
        "openapi": {
            "tier": "implementation",
            "allow": ["cli", "contract", "hono"]
        },
        "queue": { "tier": "implementation", "allow": ["contract", "redis"] },
        // `realtime` is a pure sink (nothing imports it → no cycle). It reaches
        // `hono` only for `upgradeWebSocket` (via `@lockness/hono/deno`) and the
        // `WSContext` type (`@lockness/hono/network`), and `redis` for the
        // cross-process broadcast driver (hard, lazy-connect — mirrors queue).
        // `deprecation-contracts` (#392) is a zero-dependency foundation package
        // (see its own entry above) — `disconnect`'s id-form notice.
        // `events` is a SOFT edge: the events→broadcast bridge soft-loads it,
        // typed by local structural interfaces (an `import type` would harden
        // the edge and fail this check). `@lockness/notification` is a dev/test
        // dependency only (the SC-005 BroadcasterLike conformance test) and is
        // invisible to this scan, which excludes `tests/`.
        "realtime": {
            "tier": "implementation",
            "allow": ["contract", "deprecation-contracts", "hono", "redis"],
            "soft": ["events"],
            "runtimeImports": {
                "events_bridge.ts": {
                    "sites": 1,
                    "reason": "soft-loads @lockness/events through a variable, so the edge stays soft"
                }
            }
        },
        "scheduler": { "tier": "implementation", "allow": [] },
        "session": {
            "tier": "implementation",
            "allow": ["contract", "crypto", "hono", "redis"]
        },
        "testing": {
            "tier": "orchestration",
            "allow": ["auth", "hono", "contract", "session", "drizzle"]
        },
        "socialite": {
            "tier": "implementation",
            "allow": ["hono", "contract"]
        },
        "sse": { "tier": "implementation", "allow": ["contract"] },
        "telemetry": {
            "tier": "implementation",
            "allow": ["contract", "hono"]
        },
        "storage": { "tier": "implementation", "allow": [] },
        // `ui` reaches `markdown` one way: `ui/markdown.tsx` and
        // `ui/docs_renderer.tsx` use the markdown rendering engine. `markdown`
        // does NOT import `ui` back (its default component map is plain HTML);
        // the styled map lives here in `ui/markdown.tsx`. The former cycle
        // (#127) is retired — do not re-add `ui` to `markdown`'s allow.
        "ui": {
            "tier": "implementation",
            "allow": ["hono", "markdown"],
            "runtimeImports": {
                "doc_loader.ts": {
                    "sites": 1,
                    "reason": "loads a component's examples.tsx from a components directory on disk, the development fallback"
                }
            }
        },
        "upgrade": { "tier": "implementation", "allow": [] },
        "validator": { "tier": "implementation", "allow": ["hono"] },
        // `vite` is framework-agnostic build tooling: the SSR bridge takes
        // `App.fetch()` by injection, so it imports NOTHING from the workspace
        // (`allow: []`) and `core` never imports it — the DAG stays acyclic.
        "vite": {
            "tier": "implementation",
            "allow": [],
            "runtimeImports": {
                "src/plugins/deno.ts": {
                    "sites": 1,
                    "reason": "import.meta.resolve of an npm: or https: specifier Vite asks the Deno resolver plugin about"
                }
            }
        },

        // ---- Orchestration: the only package a user application imports.
        "core": {
            "tier": "orchestration",
            "allow": [
                "container",
                "contract",
                "crypto",
                "events",
                "hono",
                "scheduler"
            ],
            // `deprecation-contracts` is declared here, not detected: its jsr
            // specifier has sat in core/deno.json since 0.1.30, but no
            // `tryImportOptionalPackage` call site loads it yet (#392 review).
            // Declared so the dependency `core`'s own manifest already claims
            // is not invisible to `deprecation-contracts`'s "Imported by" row;
            // wiring the actual soft-load (or removing the stale specifier) is
            // separate, unstarted work.
            "soft": [
                "cache",
                "container",
                "deprecation-contracts",
                "devtools",
                "drizzle",
                "events",
                "i18n",
                "logger",
                "redis",
                "session",
                "telemetry"
            ],
            "runtimeImports": {
                "events/listener_discovery.ts": {
                    "sites": 1,
                    "reason": "discoverListeners loads each listener file found under the user app's directory"
                },
                "exceptions/handler.ts": {
                    "sites": 1,
                    "reason": "loads the user app's custom error handler file when it exists"
                },
                "kernel/bootstrap/helpers.ts": {
                    "sites": 1,
                    "reason": "tryImportOptionalPackage loads the soft-edge packages listed under soft; the name is an argument"
                },
                "routing/discovery.ts": {
                    "sites": 1,
                    "reason": "controller discovery loads each controller file found in the user app"
                },
                "scheduler/schedule_discovery.ts": {
                    "sites": 1,
                    "reason": "schedule discovery loads each task file found in the user app"
                },
                "ssg/enumerate.ts": {
                    "sites": 1,
                    "reason": "static generation loads each controller file to find the @Static ones"
                }
            }
        }
    }
}
