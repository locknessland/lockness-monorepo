{
    "description": "Lockness Project Monorepo which contains all packages",
    "license": "MIT",
    "version": "0.1.20",
    "workspace": [
        "./packages/core",
        "./packages/hono",
        "./packages/auth",
        "./packages/cache",
        "./packages/container",
        "./packages/events",
        "./packages/logger",
        "./packages/mail",
        "./packages/openapi",
        "./packages/queue",
        "./packages/session",
        "./packages/socialite",
        "./packages/storage",
        "./packages/validator",
        "./packages/cli",
        "./packages/drizzle",
        "./packages/init",
        "./packages/deprecation-contracts",
        "./packages/devtools"
    ],
    "nodeModulesDir": "auto",
    "tasks": {
        "dev": "deno run -A --watch --env main.ts",
        "build": "deno task css:build",
        "compile": "deno task routes:generate && deno task css:build && deno compile --output=_dist/lockness --env-file=.env.production.local -A main.ts && cp -r public _dist/",
        "start": "deno run -A --env-file=.env.production.local main.ts",
        "cli": "deno run -A --env cli.ts",
        "css:build": "deno run -A @tailwindcss/cli -i app/view/assets/app.css -o public/css/app.css",
        "css:watch": "deno run -A @tailwindcss/cli -i app/view/assets/app.css -o public/css/app.css --watch",
        "test": "deno test -A packages/",
        "test:watch": "deno test -A --watch packages/",
        "test:coverage": "rm -rf coverage && deno test -A --coverage=coverage packages/ && deno coverage coverage --lcov > coverage/lcov.info && rm -f coverage/*.json",
        "routes:generate": "deno run -A scripts/generate_routes.ts",
        "routes:watch": "deno run -A scripts/watch_routes.ts",
        "bump": "deno run -A ./scripts/bump.ts",
        "hooks:install": "deno run -A scripts/install_hooks.ts",
        "init": "deno run -Ar packages/init/mod.ts _lockness_app"
    },
    "imports": {
        "@/": "./",
        "@controller/": "./app/controller/",
        "@service/": "./app/service/",
        "@middleware/": "./app/middleware/",
        "@model/": "./app/model/",
        "@repository/": "./app/repository/",
        "@view/": "./app/view/",
        "@kernel": "./app/kernel.tsx",
        "@std/assert": "jsr:@std/assert@1",
        "@std/cli": "jsr:@std/cli@1",
        "@std/fs": "jsr:@std/fs@1",
        "@std/path": "jsr:@std/path@1",
        "@std/jsonc": "jsr:@std/jsonc@1",
        "postgres": "npm:postgres@^3.4.4",
        "drizzle-orm": "npm:drizzle-orm@^0.36.3",
        "drizzle-zod": "npm:drizzle-zod@^0.5.1",
        "drizzle-kit": "npm:drizzle-kit@beta",
        "@lockness/core": "jsr:@lockness/core@^0.1.20",
        "zod": "npm:zod@^4.2.1",
        "@hono/zod-validator": "jsr:@lockness/hono@^0.1.20",
        "tailwindcss": "npm:tailwindcss@^4.1.18",
        "@tailwindcss/cli": "npm:@tailwindcss/cli@^4.1.18"
    },
    "unstable": [
        "kv"
    ],
    "fmt": {
        "indentWidth": 4,
        "useTabs": false,
        "singleQuote": true,
        "proseWrap": "always",
        "lineWidth": 80,
        "semiColons": false
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "@lockness/core"
    },
    "lockness": {
        "packages": [
            "drizzle",
            "init",
            "openapi"
        ]
    },
    "allowScripts": {
        "allow": [],
        "deny": [
            "npm:@parcel/watcher@2.5.4",
            "npm:esbuild@0.25.12",
            "npm:esbuild@0.27.2",
            "npm:fsevents@2.3.3"
        ]
    }
}
