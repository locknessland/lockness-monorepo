APP_ENV=development
PORT=8888
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lockness"
APP_KEY="your-secret-key-here-change-in-production"

# Mail Configuration
MAIL_DRIVER=console
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Lockness App"

# SMTP (if MAIL_DRIVER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASS=your-password

# Resend (if MAIL_DRIVER=resend)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Queue Configuration
QUEUE_DRIVER=memory
# QUEUE_DRIVER=deno-kv