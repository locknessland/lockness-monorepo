{
    "name": "@lockness/cli",
    "version": "0.1.3",
    "license": "MIT",
    "exports": {
        ".": "./mod.ts",
        "./commands": "./core_commands.ts"
    },
    "publish": {
        "include": [
            "mod.ts",
            "auto_register.ts",
            "core_commands.ts",
            "package_loader.ts",
            "routes_generator.ts",
            "stubs.ts",
            "deno.json",
            "README.md",
            "stubs/**/*",
            "commands/**/*.ts"
        ],
        "exclude": [
            "tests/"
        ]
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "imports": {
        "@std/path": "jsr:@std/path@^1.0.0",
        "@std/assert": "jsr:@std/assert@1",
        "@std/fs": "jsr:@std/fs@1"
    }
}
