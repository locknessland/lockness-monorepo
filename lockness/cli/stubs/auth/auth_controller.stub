import { Controller, Get, Post, Guest, Context, auth, session, Validate, route } from 'lockness/core'
import { z } from 'zod'

const loginSchema = z.object({
    email: z.string().email('Invalid email'),
    password: z.string().min(1, 'Password is required'),
})

const registerSchema = z.object({
    email: z.string().email('Invalid email'),
    password: z.string().min(8, 'Password must be at least 8 characters'),
    password_confirmation: z.string(),
}).refine((data) => data.password === data.password_confirmation, {
    message: 'Passwords do not match',
    path: ['password_confirmation'],
})

@Controller('/auth')
export class AuthController {
    @Guest('/dashboard')
    @Get('/login', { name: 'auth.login' })
    showLogin(c: Context) {
        const error = session(c).getFlash('error')
        return c.html(`
            <!DOCTYPE html>
            <html>
            <head><title>Login</title></head>
            <body>
                <h1>Login</h1>
                ${error ? `<p style="color: red">${error}</p>` : ''}
                <form method="POST" action="${route('auth.login.submit')}">
                    <input type="email" name="email" placeholder="Email" required />
                    <input type="password" name="password" placeholder="Password" required />
                    <button type="submit">Login</button>
                </form>
                <p>Don't have an account? <a href="${route('auth.register')}">Register</a></p>
            </body>
            </html>
        `)
    }

    @Guest('/dashboard')
    @Post('/login', { name: 'auth.login.submit' })
    @Validate('form', loginSchema)
    async login(c: Context) {
        const { email, password } = c.req.valid('form')
        const guard = auth(c)

        const success = await guard.attempt(email, password)

        if (!success) {
            session(c).flash('error', 'Invalid credentials')
            return c.redirect(route('auth.login'))
        }

        session(c).flash('success', 'Welcome back!')
        return c.redirect('/dashboard')
    }

    @Guest('/dashboard')
    @Get('/register', { name: 'auth.register' })
    showRegister(c: Context) {
        const error = session(c).getFlash('error')
        return c.html(`
            <!DOCTYPE html>
            <html>
            <head><title>Register</title></head>
            <body>
                <h1>Register</h1>
                ${error ? `<p style="color: red">${error}</p>` : ''}
                <form method="POST" action="${route('auth.register.submit')}">
                    <input type="email" name="email" placeholder="Email" required />
                    <input type="password" name="password" placeholder="Password" required />
                    <input type="password" name="password_confirmation" placeholder="Confirm Password" required />
                    <button type="submit">Register</button>
                </form>
                <p>Already have an account? <a href="${route('auth.login')}">Login</a></p>
            </body>
            </html>
        `)
    }

    @Guest('/dashboard')
    @Post('/register', { name: 'auth.register.submit' })
    @Validate('form', registerSchema)
    async register(c: Context) {
        // TODO: Implement registration logic
        // 1. Check if user exists
        // 2. Hash password with hashPassword()
        // 3. Create user in database
        // 4. Log in the user

        session(c).flash('success', 'Account created! Please log in.')
        return c.redirect(route('auth.login'))
    }

    @Post('/logout', { name: 'auth.logout' })
    async logout(c: Context) {
        await auth(c).logout()
        session(c).flash('success', 'Logged out successfully')
        return c.redirect(route('auth.login'))
    }
}
