{
    "name": "@lockness/auth",
    "version": "0.1.0",
    "exports": "./mod.ts",
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "include": [
            "mod.ts",
            "authenticator.ts",
            "errors.ts",
            "types.ts",
            "deno.json",
            "README.md",
            "guards/**/*.ts",
            "middleware/**/*.ts",
            "providers/**/*.ts"
        ],
        "exclude": [
            "tests/"
        ]
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@1",
        "hono": "npm:hono@^4.11.1",
        "hono/cookie": "npm:hono@^4.11.1/cookie",
        "drizzle-orm": "npm:drizzle-orm@^0.36.3"
    }
}
