{
    "name": "@lockness/core",
    "version": "0.1.0",
    "exports": {
        ".": "./mod.ts",
        "./jsx": "./jsx.ts",
        "./jsx-runtime": "./jsx-runtime.ts"
    },
    "publish": {
        "include": [
            "mod.ts",
            "app.ts",
            "auth.ts",
            "components.tsx",
            "container.ts",
            "decorators.ts",
            "helpers.ts",
            "router.ts",
            "types.ts",
            "validation.ts",
            "jsx.ts",
            "jsx-runtime.ts",
            "deno.json",
            "README.md"
        ],
        "exclude": [
            "tests/"
        ]
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "imports": {
        "@std/path": "jsr:@std/path@^1.0.0",
        "@std/assert": "jsr:@std/assert@1",
        "@std/testing/bdd": "jsr:@std/testing@^1.0.0/bdd",
        "@std/expect": "jsr:@std/expect@^1.0.0",
        "hono/cookie": "npm:hono@^4.11.1/cookie",
        "hono/cors": "npm:hono@^4.11.1/cors",
        "hono": "npm:hono@^4.11.1",
        "hono/": "npm:hono@^4.11.1/",
        "hono/jsx": "npm:hono@^4.11.1/jsx",
        "hono/jsx/jsx-runtime": "npm:hono@^4.11.1/jsx/jsx-runtime",
        "hono/jsx-renderer": "npm:hono@^4.11.1/jsx-renderer",
        "hono/deno": "npm:hono@^4.11.1/deno",
        "hono/html": "npm:hono@^4.11.1/html",
        "hono/types": "npm:hono@^4.11.1/types"
    }
}
