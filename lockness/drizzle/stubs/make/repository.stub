import { Service, Inject } from 'lockness'
import { Database } from '@lockness/drizzle'
import { {{ tableName }}, type {{ className }} } from '@model/{{ modelFileName }}.ts'
import { eq } from 'drizzle-orm'

@Service()
export class {{ className }}Repository {
    @Inject(Database)
    private database!: Database

    /**
     * Find all {{ className }}
     */
    async findAll(): Promise<{{ className }}[]> {
        return await this.database.db.select().from({{ tableName }})
    }

    /**
     * Find {{ className }} by ID
     */
    async findById(id: number): Promise<{{ className }} | null> {
        const result = await this.database.db.select().from({{ tableName }}).where(eq({{ tableName }}.id, id))
        return result[0] || null
    }
}
