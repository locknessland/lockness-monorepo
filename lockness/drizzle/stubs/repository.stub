import { Inject, Service } from 'lockness/core'
import { Database } from '@lockness/drizzle'
import { type {{ModelName}}, type New{{ModelName}}, {{tableName}} } from '@model/{{fileName}}.ts'
import { eq } from 'drizzle-orm'

@Service()
export class {{RepositoryName}} {
    @Inject(Database)
    private database!: Database

    /**
     * Find all {{ModelName}}
     */
    async findAll(): Promise<{{ModelName}}[]> {
        return await this.database.db.select().from({{tableName}})
    }

    /**
     * Find {{ModelName}} by ID
     */
    async findById(id: number): Promise<{{ModelName}} | null> {
        const result = await this.database.db.select().from({{tableName}}).where(
            eq({{tableName}}.id, id),
        )
        return result[0] || null
    }

    /**
     * Create a new {{ModelName}}
     */
    async create(data: New{{ModelName}}): Promise<{{ModelName}}> {
        const result = await this.database.db.insert({{tableName}}).values(data)
            .returning()
        return result[0]
    }

    /**
     * Update {{ModelName}} by ID
     */
    async update(id: number, data: Partial<New{{ModelName}}>): Promise<{{ModelName}} | null> {
        const result = await this.database.db.update({{tableName}})
            .set(data)
            .where(eq({{tableName}}.id, id))
            .returning()
        return result[0] || null
    }

    /**
     * Delete {{ModelName}} by ID
     */
    async delete(id: number): Promise<boolean> {
        const result = await this.database.db.delete({{tableName}})
            .where(eq({{tableName}}.id, id))
            .returning()
        return result.length > 0
    }
}
