{
    "name": "@lockness/devtools",
    "version": "0.1.0",
    "exports": "./mod.ts",
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "include": [
            "mod.ts",
            "collector.ts",
            "middleware.ts",
            "types.ts",
            "dashboard.tsx",
            "components",
            "deno.json",
            "README.md"
        ],
        "exclude": [
            "tests/"
        ]
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "@lockness/core"
    },
    "imports": {
        "hono": "npm:hono@^4.11.1",
        "hono/": "npm:hono@^4.11.1/",
        "hono/jsx": "npm:hono@^4.11.1/jsx",
        "hono/cors": "npm:hono@^4.11.1/cors"
    }
}
