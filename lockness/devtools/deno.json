{
    "name": "@lockness/devtools",
    "version": "0.1.17",
    "license": "MIT",
    "exports": "./mod.ts",
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "include": [
            "mod.ts",
            "collector.ts",
            "middleware.ts",
            "types.ts",
            "dashboard.tsx",
            "components",
            "deno.json",
            "README.md"
        ],
        "exclude": [
            "tests/"
        ]
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "hono"
    },
    "imports": {
        "@lockness/core": "jsr:@lockness/core@^0.1.17",
        "hono": "jsr:@lockness/hono@^0.1.17"
    },
    "description": "Development debugging toolbar and utilities for Lockness framework"
}
