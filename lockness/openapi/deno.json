{
    "name": "@lockness/openapi",
    "version": "0.1.0",
    "exports": {
        ".": "./mod.ts",
        "./install": "./install.ts"
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "include": [
            "mod.ts",
            "generator.ts",
            "decorator.ts",
            "types.ts",
            "ui.ts",
            "cli_commands.ts",
            "install.ts",
            "stubs",
            "deno.json",
            "README.md"
        ],
        "exclude": [
            "tests/"
        ]
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@1",
        "hono": "npm:hono@^4.11.1",
        "hono/": "npm:hono@^4.11.1/"
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "@lockness/core"
    }
}
