import {
    App,
    configureSession,
    container,
    sessionMiddleware,
    type Context,
} from 'lockness'
import { Database } from '@lockness/drizzle'
import {
    authMiddleware,
    initializeAuthMiddleware,
    SessionGuard,
} from '@lockness/auth'
