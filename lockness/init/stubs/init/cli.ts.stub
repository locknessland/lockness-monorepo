import { Cli } from '@lockness/cli'
import { registerCoreCommands } from '@lockness/cli/commands'
import { registerDrizzleCommands } from '@lockness/drizzle/commands'

const cli = new Cli()

// Register framework commands (make:controller, make:middleware, etc.)
registerCoreCommands(cli)

// Register Drizzle ORM commands (db:generate, db:migrate, db:seed, etc.)
registerDrizzleCommands(cli)

// Discover user-defined commands in src/command/
await cli.discoverCommands('./src/command')

if (import.meta.main) {
    await cli.run(Deno.args)
}
