APP_ENV=development
PORT=8888

# Database Configuration
DATABASE_URL=postgres://username:password@localhost:5432/{{projectName}}

# Application Key (used for encryption, sessions, etc.)
APP_KEY=your-secret-key-here-change-in-production

# Mail Configuration
MAIL_DRIVER=console
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="{{projectName}}"

# SMTP (if MAIL_DRIVER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASS=your-password

# Resend (if MAIL_DRIVER=resend)
# RESEND_API_KEY=re_xxxxxxxxxxxx
