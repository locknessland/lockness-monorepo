{
    "workspace": [],
    "nodeModulesDir": "auto",
    "tasks": {
        "dev": "VITE=true deno run -A --env npm:vite dev",
        "build": "deno run -A npm:vite build && deno run -A npm:vite build --ssr",
        "preview": "deno run -A npm:vite preview",
        "start": "deno run --allow-net --allow-read --allow-env --allow-sys --allow-run --env dist/server.js",
        "ace": "deno run -A --env ace.ts"
    },
    "imports": {
        "@/": "./",
        "lockness": "jsr:@lockness/core@^0.1.3",
        "@lockness/core": "jsr:@lockness/core@^0.1.3",
        "@lockness/ace": "jsr:@lockness/ace@^0.1.3",
        "@lockness/ace/commands": "jsr:@lockness/ace@^0.1.3/commands",
        "@lockness/drizzle": "jsr:@lockness/drizzle@^0.1.3",
        "@lockness/drizzle/commands": "jsr:@lockness/drizzle@^0.1.3/commands",
        "drizzle-orm": "npm:drizzle-orm@^0.36.3",
        "drizzle-zod": "npm:drizzle-zod@^0.5.1",
        "drizzle-kit": "npm:drizzle-kit@^0.27.2",
        "postgres": "npm:postgres@^3.4.4",
        "hono": "npm:hono@^4.6.14",
        "hono/": "npm:hono@^4.6.14/",
        "vite": "npm:vite@^5.4.11",
        "@hono/vite-dev-server": "npm:@hono/vite-dev-server@^0.12.0"
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "hono/jsx",
        "experimentalDecorators": true
    }
}
