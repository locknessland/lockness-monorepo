{
    "name": "@lockness/core",
    "version": "0.4.0",
    "description": "Core framework components providing MVC architecture, routing engine, decorators, and dependency injection",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "lockness-source": "./mod.ts",
            "default": "./dist/mod.js"
        },
        "./jsx": {
            "lockness-source": "./view/jsx.ts",
            "default": "./dist/view/jsx.js"
        },
        "./jsx-runtime": {
            "lockness-source": "./view/jsx_runtime.ts",
            "default": "./dist/view/jsx_runtime.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "deno": ">=2.2"
    },
    "dependencies": {
        "@lockness/hono": "^0.4.0",
        "@lockness/contract": "^0.4.0",
        "@lockness/container": "^0.4.0",
        "@lockness/deprecation-contracts": "^0.4.0",
        "@lockness/events": "^0.4.0",
        "@lockness/scheduler": "^0.4.0",
        "@lockness/crypto": "^0.4.0"
    },
    "peerDependencies": {
        "@lockness/cache": "^0.4.0",
        "@lockness/devtools": "^0.4.0",
        "@lockness/drizzle": "^0.4.0",
        "@lockness/i18n": "^0.4.0",
        "@lockness/logger": "^0.4.0",
        "@lockness/redis": "^0.4.0",
        "@lockness/session": "^0.4.0",
        "@lockness/telemetry": "^0.4.0"
    },
    "peerDependenciesMeta": {
        "@lockness/cache": {
            "optional": true
        },
        "@lockness/devtools": {
            "optional": true
        },
        "@lockness/drizzle": {
            "optional": true
        },
        "@lockness/i18n": {
            "optional": true
        },
        "@lockness/logger": {
            "optional": true
        },
        "@lockness/redis": {
            "optional": true
        },
        "@lockness/session": {
            "optional": true
        },
        "@lockness/telemetry": {
            "optional": true
        }
    },
    "devDependencies": {
        "@lockness/cli": "^0.4.0",
        "@lockness/auth": "^0.4.0",
        "@lockness/drizzle": "^0.4.0",
        "@lockness/session": "^0.4.0"
    },
    "lockness": {
        "jsr": {
            "@std/path": "^1.0.0",
            "@std/assert": "1",
            "@std/expect": "^1.0.0",
            "@std/fs": "1"
        },
        "imports": {
            "hono": "@lockness/hono",
            "@lockness/cli": "@lockness/cli"
        },
        "publish": {
            "exclude": [
                "tests/",
                "docs/"
            ]
        },
        "compilerOptions": {
            "jsx": "precompile",
            "jsxImportSource": "hono"
        },
        "tasks": {
            "test": "deno test -A tests/",
            "test:watch": "deno test -A --watch tests/"
        },
        "versionModule": true
    }
}
