{
    "name": "@lockness/core",
    "version": "0.1.30",
    "license": "MIT",
    "exports": {
        ".": "./mod.ts",
        "./jsx": "./view/jsx.ts",
        "./jsx-runtime": "./view/jsx_runtime.ts"
    },
    "publish": {
        "exclude": [
            "tests/",
            "docs/"
        ]
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "imports": {
        "@std/path": "jsr:@std/path@^1.0.0",
        "@std/assert": "jsr:@std/assert@1",
        "@std/testing/bdd": "jsr:@std/testing@^1.0.0/bdd",
        "@std/expect": "jsr:@std/expect@^1.0.0",
        "hono": "jsr:@lockness/hono@^0.1.30",
        "@lockness/contract": "jsr:@lockness/contract@^0.1.30",
        "@lockness/container": "jsr:@lockness/container@^0.1.30",
        "@lockness/deprecation-contracts": "jsr:@lockness/deprecation-contracts@^0.1.30",
        "@lockness/events": "jsr:@lockness/events@^0.1.30"
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "hono"
    },
    "description": "Core framework components providing MVC architecture, routing engine, decorators, and dependency injection"
}
