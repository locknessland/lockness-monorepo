{
    "name": "@lockness/core",
    "version": "0.1.26",
    "license": "MIT",
    "exports": {
        ".": "./mod.ts",
        "./jsx": "./jsx.ts",
        "./jsx-runtime": "./jsx-runtime.ts"
    },
    "publish": {
        "include": [
            "mod.ts",
            "app.ts",
            "decorators.ts",
            "helpers.ts",
            "router.ts",
            "types.ts",
            "jsx.ts",
            "jsx-runtime.ts",
            "controller_discovery.ts",
            "default_error_handler.tsx",
            "error_formatter.ts",
            "error_handler_registry.ts",
            "middleware_resolver.ts",
            "route_registry.ts",
            "server_listener.ts",
            "static_file_server.ts",
            "kernel/decorators.ts",
            "kernel/boot_runner.ts",
            "deno.json",
            "README.md"
        ],
        "exclude": [
            "tests/",
            "docs/examples/"
        ]
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "imports": {
        "@std/path": "jsr:@std/path@^1.0.0",
        "@std/assert": "jsr:@std/assert@1",
        "@std/testing/bdd": "jsr:@std/testing@^1.0.0/bdd",
        "@std/expect": "jsr:@std/expect@^1.0.0",
        "hono": "jsr:@lockness/hono@^0.1.26"
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "hono"
    },
    "description": "Core framework components providing MVC architecture, routing engine, decorators, and dependency injection"
}
