{
    "name": "@lockness/validator",
    "version": "0.4.0",
    "description": "Advanced validation system with 30+ built-in validators, async validation, sanitizers, and Zod decorator for controllers",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "lockness-source": "./mod.ts",
            "default": "./dist/mod.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "deno": ">=2.2"
    },
    "dependencies": {
        "@lockness/hono": "^0.4.0",
        "zod": "^3.25.0"
    },
    "lockness": {
        "jsr": {
            "@std/assert": "1"
        },
        "imports": {
            "@lockness/hono/zod-validator": "@lockness/hono"
        },
        "publish": {
            "include": [
                "mod.ts",
                "rules/mod.ts",
                "sanitisers/mod.ts",
                "validation.ts",
                "zod_decorator.ts",
                "deno.json",
                "README.md"
            ],
            "exclude": [
                "tests/"
            ]
        },
        "tasks": {
            "test": "deno test -A tests/",
            "test:watch": "deno test -A --watch tests/"
        }
    }
}
