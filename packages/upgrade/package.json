{
    "name": "@lockness/upgrade",
    "version": "0.4.0",
    "description": "Automated upgrade tool for Lockness projects - updates all @lockness/* dependencies to latest or specified version",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "lockness-source": "./mod.ts",
            "default": "./dist/mod.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "deno": ">=2.2"
    },
    "dependencies": {
        "@lockness/cli": "^0.4.0"
    },
    "devDependencies": {
        "@std/path": "jsr:^1.0.0",
        "@std/assert": "jsr:1"
    },
    "lockness": {
        "jsr": {
            "@std/cli": "^1.0.0",
            "@std/jsonc": "^1.0.0"
        },
        "publish": {
            "include": [
                "mod.ts",
                "cli.ts",
                "upgrader.ts",
                "version_fetcher.ts",
                "types.ts",
                "README.md",
                "deno.json"
            ],
            "exclude": [
                "tests/"
            ]
        },
        "tasks": {
            "test": "deno test -A tests/",
            "test:watch": "deno test -A --watch tests/"
        }
    }
}
