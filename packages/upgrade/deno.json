{
    "name": "@lockness/upgrade",
    "version": "0.4.0",
    "license": "MIT",
    "description": "Automated upgrade tool for Lockness projects - updates all @lockness/* dependencies to latest or specified version",
    "exports": {
        ".": "./mod.ts"
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "include": [
            "mod.ts",
            "cli.ts",
            "upgrader.ts",
            "version_fetcher.ts",
            "types.ts",
            "README.md",
            "deno.json"
        ],
        "exclude": [
            "tests/",
            "package.json",
            "tsconfig.json"
        ]
    },
    "imports": {
        "@lockness/cli": "jsr:@lockness/cli@^0.4.0",
        "@std/cli": "jsr:@std/cli@^1.0.0",
        "@std/jsonc": "jsr:@std/jsonc@^1.0.0",
        "@std/path": "jsr:@std/path@^1.0.0",
        "@std/assert": "jsr:@std/assert@1"
    }
}
