{
    "name": "@lockness/events",
    "version": "0.4.0",
    "license": "MIT",
    "description": "Type-safe event emitter with async support, priorities, wildcards, and isolated event buses",
    "exports": {
        ".": "./mod.ts"
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "exclude": [
            "tests/",
            "package.json",
            "tsconfig.json"
        ]
    },
    "imports": {
        "@lockness/contract": "jsr:@lockness/contract@^0.4.0",
        "@lockness/hono": "jsr:@lockness/hono@^0.4.0",
        "@std/assert": "jsr:@std/assert@1",
        "@std/fs": "jsr:@std/fs@1",
        "@std/path": "jsr:@std/path@1"
    }
}
