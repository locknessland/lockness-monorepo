{
    "name": "@lockness/notification",
    "version": "0.4.0",
    "license": "MIT",
    "description": "Multi-channel notification delivery for Lockness — one Notification class fans out to mail/database/log/broadcast channels, each backing package loaded on demand",
    "exports": {
        ".": "./mod.ts"
    },
    "tasks": {
        "test": "deno test -A tests/"
    },
    "publish": {
        "exclude": [
            "tests/",
            "package.json",
            "tsconfig.json"
        ]
    },
    "imports": {
        "@lockness/contract": "jsr:@lockness/contract@^0.4.0",
        "@lockness/container": "jsr:@lockness/container@^0.4.0",
        "@std/assert": "jsr:@std/assert@1",
        "@std/path": "jsr:@std/path@1",
        "@lockness/cli": "jsr:@lockness/cli@^0.4.0"
    }
}
