{
    "name": "@lockness/openapi",
    "version": "0.1.25",
    "license": "MIT",
    "exports": {
        ".": "./mod.ts",
        "./install": "./install.ts"
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "include": [
            "mod.ts",
            "generator.ts",
            "decorator.ts",
            "types.ts",
            "ui.ts",
            "cli_commands.ts",
            "install.ts",
            "stubs",
            "deno.json",
            "README.md"
        ],
        "exclude": [
            "tests/"
        ]
    },
    "imports": {
        "@lockness/core": "jsr:@lockness/core@^0.1.25",
        "@std/assert": "jsr:@std/assert@1",
        "hono": "jsr:@lockness/hono@^0.1.25"
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "hono"
    },
    "description": "OpenAPI 3.0 documentation generator with decorator-based route documentation and Swagger UI integration"
}
