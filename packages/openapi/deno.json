{
    "name": "@lockness/openapi",
    "version": "0.1.29",
    "license": "MIT",
    "exports": {
        ".": "./mod.ts",
        "./install": "./install.ts"
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "exclude": [
            "tests/"
        ]
    },
    "imports": {
        "@lockness/contract": "jsr:@lockness/contract@^0.1.29",
        "@std/assert": "jsr:@std/assert@1",
        "hono": "jsr:@lockness/hono@^0.1.29"
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "hono"
    },
    "description": "OpenAPI 3.0 documentation generator with decorator-based route documentation and Swagger UI integration"
}
