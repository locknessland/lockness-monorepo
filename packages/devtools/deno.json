{
    "name": "@lockness/devtools",
    "version": "0.4.0",
    "license": "MIT",
    "description": "Development debugging toolbar and utilities for Lockness framework",
    "exports": {
        ".": "./mod.ts"
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "exclude": [
            "tests/",
            "docs/",
            ".github/",
            "package.json",
            "tsconfig.json"
        ]
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "@lockness/hono"
    },
    "imports": {
        "@lockness/hono": "jsr:@lockness/hono@^0.4.0",
        "@lockness/contract": "jsr:@lockness/contract@^0.4.0",
        "@lockness/events": "jsr:@lockness/events@^0.4.0",
        "@lockness/session": "jsr:@lockness/session@^0.4.0",
        "@std/fs": "jsr:@std/fs@1",
        "@std/path": "jsr:@std/path@1"
    }
}
