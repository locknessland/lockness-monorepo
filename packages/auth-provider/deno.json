{
    "name": "@lockness/auth-provider",
    "version": "0.2.0",
    "license": "MIT",
    "description": "Agnostic user providers for @lockness/auth. Support for Drizzle, Kysely, and more.",
    "exports": {
        ".": "./mod.ts",
        "./base": "./base/mod.ts",
        "./drizzle": "./drizzle/mod.ts",
        "./kysely": "./kysely/mod.ts"
    },
    "lint": {
        "exclude": [
            "node_modules"
        ],
        "rules": {
            "exclude": [
                "no-explicit-any"
            ]
        }
    },
    "imports": {
        "@lockness/auth": "jsr:@lockness/auth@^0.2.0",
        "drizzle-orm/postgres-js": "npm:drizzle-orm@^0.36.3/postgres-js",
        "drizzle-orm/mysql2": "npm:drizzle-orm@^0.36.3/mysql2",
        "drizzle-orm/libsql": "npm:drizzle-orm@^0.36.3/libsql"
    }
}
