{
    "name": "@lockness/socialite",
    "version": "0.4.0",
    "description": "OAuth2/OIDC social authentication with built-in providers (Google, GitHub, Discord) and extensible driver system",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "lockness-source": "./mod.ts",
            "default": "./dist/mod.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "deno": ">=2.2"
    },
    "dependencies": {
        "@lockness/hono": "^0.4.0",
        "@lockness/contract": "^0.4.0"
    },
    "lockness": {
        "jsr": {
            "@std/crypto": "^1",
            "@std/encoding": "^1",
            "@std/assert": "1",
            "@std/expect": "^1.0.0"
        },
        "imports": {
            "hono": "@lockness/hono"
        },
        "publish": {
            "include": [
                "mod.ts",
                "deno.json",
                "README.md"
            ],
            "exclude": [
                "tests/"
            ]
        },
        "tasks": {
            "test": "deno test -A tests/",
            "test:watch": "deno test -A --watch tests/"
        }
    }
}
