{
    "name": "@lockness/socialite",
    "version": "0.4.0",
    "license": "MIT",
    "description": "OAuth2/OIDC social authentication with built-in providers (Google, GitHub, Discord) and extensible driver system",
    "exports": {
        ".": "./mod.ts"
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "include": [
            "mod.ts",
            "deno.json",
            "README.md"
        ],
        "exclude": [
            "tests/",
            "package.json",
            "tsconfig.json"
        ]
    },
    "imports": {
        "@lockness/hono": "jsr:@lockness/hono@^0.4.0",
        "@lockness/contract": "jsr:@lockness/contract@^0.4.0",
        "@std/crypto": "jsr:@std/crypto@^1",
        "@std/encoding": "jsr:@std/encoding@^1",
        "@std/assert": "jsr:@std/assert@1",
        "@std/expect": "jsr:@std/expect@^1.0.0",
        "hono": "jsr:@lockness/hono@^0.4.0"
    }
}
