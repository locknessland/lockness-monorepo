{
    "name": "@lockness/i18n",
    "version": "0.4.0",
    "license": "MIT",
    "description": "Translation layer for Lockness — message catalogs, t()/trans() with ICU interpolation + Intl-backed pluralization, and a per-request locale resolver",
    "exports": {
        ".": "./mod.ts"
    },
    "tasks": {
        "test": "deno test -A tests/"
    },
    "publish": {
        "exclude": [
            "tests/",
            "package.json",
            "tsconfig.json"
        ]
    },
    "imports": {
        "@lockness/contract": "jsr:@lockness/contract@^0.4.0",
        "@lockness/hono": "jsr:@lockness/hono@^0.4.0",
        "@std/path": "jsr:@std/path@1",
        "@std/assert": "jsr:@std/assert@1",
        "@lockness/cli": "jsr:@lockness/cli@^0.4.0"
    }
}
