{
    "name": "@lockness/storage",
    "version": "0.4.0",
    "description": "File storage abstraction with multiple drivers (Local, AWS S3, Cloudflare R2), stream support, and signed URLs",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "lockness-source": "./mod.ts",
            "default": "./dist/mod.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "deno": ">=2.2"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.709.0",
        "@aws-sdk/s3-request-presigner": "^3.709.0"
    },
    "lockness": {
        "jsr": {
            "@std/assert": "1",
            "@std/path": "1",
            "@std/fs": "1"
        },
        "publish": {
            "include": [
                "mod.ts",
                "storage.ts",
                "helpers.ts",
                "types.ts",
                "drivers/local.ts",
                "drivers/s3.ts",
                "drivers/r2.ts",
                "deno.json",
                "README.md"
            ],
            "exclude": [
                "tests/"
            ]
        },
        "tasks": {
            "test": "deno test -A tests/",
            "test:watch": "deno test -A --watch tests/"
        }
    }
}
