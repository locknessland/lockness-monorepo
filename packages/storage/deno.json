{
    "name": "@lockness/storage",
    "version": "0.2.0",
    "license": "MIT",
    "exports": "./mod.ts",
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "include": [
            "mod.ts",
            "storage.ts",
            "helpers.ts",
            "types.ts",
            "drivers/local.ts",
            "drivers/s3.ts",
            "drivers/r2.ts",
            "deno.json",
            "README.md"
        ],
        "exclude": [
            "tests/"
        ]
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@1",
        "@std/path": "jsr:@std/path@1",
        "@std/fs": "jsr:@std/fs@1",
        "@aws-sdk/client-s3": "npm:@aws-sdk/client-s3@^3.709.0",
        "@aws-sdk/s3-request-presigner": "npm:@aws-sdk/s3-request-presigner@^3.709.0"
    },
    "description": "File storage abstraction with multiple drivers (Local, AWS S3, Cloudflare R2), stream support, and signed URLs"
}
