{
    "name": "@lockness/cli",
    "version": "0.4.0",
    "license": "MIT",
    "exports": {
        ".": "./mod.ts",
        "./commands": "./core_commands.ts",
        "./command-failure": "./command_failure.ts",
        "./entry": "./entry.ts"
    },
    "publish": {
        "exclude": [
            "tests/"
        ]
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "imports": {
        "@lockness/events": "jsr:@lockness/events@^0.4.0",
        "@lockness/contract": "jsr:@lockness/contract@^0.4.0",
        "@lockness/queue": "jsr:@lockness/queue@^0.4.0",
        "@lockness/core": "jsr:@lockness/core@^0.4.0",
        "@lockness/drizzle": "jsr:@lockness/drizzle@^0.4.0",
        "@lockness/features": "jsr:@lockness/features@^0.4.0",
        "@lockness/i18n": "jsr:@lockness/i18n@^0.4.0",
        "@lockness/mail": "jsr:@lockness/mail@^0.4.0",
        "@lockness/notification": "jsr:@lockness/notification@^0.4.0",
        "@lockness/openapi": "jsr:@lockness/openapi@^0.4.0",
        "@lockness/search": "jsr:@lockness/search@^0.4.0",
        "@std/assert": "jsr:@std/assert@1",
        "@std/fs": "jsr:@std/fs@1",
        "@std/jsonc": "jsr:@std/jsonc@^1.0.0",
        "@std/path": "jsr:@std/path@^1.0.0"
    },
    "description": "Command-line interface system with extensible commands, package management, and code scaffolding"
}
