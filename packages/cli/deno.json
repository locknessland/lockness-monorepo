{
    "name": "@lockness/cli",
    "version": "0.2.0",
    "license": "MIT",
    "exports": {
        ".": "./mod.ts",
        "./commands": "./core_commands.ts"
    },
    "publish": {
        "exclude": [
            "tests/"
        ]
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "imports": {
        "@lockness/contract": "jsr:@lockness/contract@^0.2.0",
        "@lockness/queue": "jsr:@lockness/queue@^0.2.0",
        "@std/assert": "jsr:@std/assert@1",
        "@std/fs": "jsr:@std/fs@1",
        "@std/path": "jsr:@std/path@^1.0.0"
    },
    "description": "Command-line interface system with extensible commands, package management, and code scaffolding"
}
