{
    "name": "@lockness/ui",
    "description": "CLI for adding Hono JSX UI components (shadcn-style) to your Lockness project",
    "version": "0.1.26",
    "license": "MIT",
    "exports": {
        ".": "./mod.ts",
        "./components": "./components.ts"
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "include": [
            "mod.ts",
            "components.ts",
            "lib/**/*.ts",
            "components/**/*.tsx",
            "deno.json",
            "README.md"
        ],
        "exclude": [
            "tests/"
        ]
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@1",
        "@std/cli": "jsr:@std/cli@1",
        "@std/fs": "jsr:@std/fs@1",
        "@std/path": "jsr:@std/path@1",
        "hono": "jsr:@lockness/hono@^0.1.26",
        "clsx": "npm:clsx@2.1.1",
        "tailwind-merge": "npm:tailwind-merge@2.6.0"
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "hono"
    }
}
