{
    "name": "@lockness/contract",
    "version": "0.1.30",
    "license": "MIT",
    "exports": {
        ".": "./mod.ts",
        "./http": "./http/mod.ts",
        "./routing": "./routing/mod.ts"
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "exclude": [
            "tests/"
        ]
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@1",
        "@std/fs": "jsr:@std/fs@1",
        "@std/path": "jsr:@std/path@1",
        "hono": "jsr:@lockness/hono@^0.1.30"
    },
    "description": "Shared contracts, types, and decorators for the Lockness framework to avoid circular dependencies"
}
