{
    "//": "hard-rule-2 exception: the mysql2 and @libsql/client npm: specifiers below are the MySQL and SQLite/libSQL client drivers that Drizzle's mysql2 and libsql adapters run on. Neither publishes a JSR build, so npm: is the only registry that ships them, and each is loaded on demand only when its dialect is selected (see drivers.ts).",
    "name": "@lockness/drizzle",
    "version": "0.4.0",
    "description": "Drizzle ORM integration with PostgreSQL support, migration management, and database seeding system",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "lockness-source": "./mod.ts",
            "default": "./dist/mod.js"
        },
        "./commands": {
            "lockness-source": "./cli_commands.ts",
            "default": "./dist/cli_commands.js"
        },
        "./install": {
            "lockness-source": "./install.ts",
            "default": "./dist/install.js"
        }
    },
    "files": [
        "dist",
        "stubs"
    ],
    "engines": {
        "deno": ">=2.2"
    },
    "dependencies": {
        "@lockness/cli": "^0.4.0",
        "@lockness/container": "^0.4.0",
        "@lockness/contract": "^0.4.0",
        "drizzle-orm": "^0.36.3",
        "postgres": "^3.4.4",
        "mysql2": "^3.24.3",
        "@libsql/client": "^0.18.0"
    },
    "lockness": {
        "jsr": {
            "@std/path": "^1.0.0"
        },
        "imports": {
            "mysql2/promise": "mysql2/promise"
        },
        "publish": {
            "exclude": [
                "tests/"
            ]
        }
    }
}
