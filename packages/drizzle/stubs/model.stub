{{tableImports}}
import { createInsertSchema, createSelectSchema } from 'drizzle-zod'

export const {{tableName}} = {{tableFn}}('{{tableName}}', {
    {{idColumn}}
    // Add your columns here
    {{createdAtColumn}}
    {{updatedAtColumn}}
})

// Zod schemas for validation (customize as needed)
export const insert{{ModelName}}Schema = createInsertSchema({{tableName}})
export const select{{ModelName}}Schema = createSelectSchema({{tableName}})

// TypeScript types
export type {{ModelName}} = typeof {{tableName}}.$inferSelect
export type New{{ModelName}} = typeof {{tableName}}.$inferInsert
