{
    "name": "@lockness/markdown",
    "version": "0.4.0",
    "description": "Markdown to JSX renderer with a plain-HTML default component map (styled output via @lockness/ui/markdown)",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "lockness-source": "./mod.tsx",
            "default": "./dist/mod.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "deno": ">=2.2"
    },
    "dependencies": {
        "@lockness/hono": "^0.4.0"
    },
    "devDependencies": {
        "@std/assert": "jsr:1"
    },
    "lockness": {
        "jsr": {
            "@libs/markdown": "^2.1.0"
        },
        "publish": {
            "include": [
                "mod.tsx",
                "parser.ts",
                "renderer.tsx",
                "types.ts",
                "deno.json",
                "README.md"
            ],
            "exclude": [
                "tests/"
            ]
        },
        "compilerOptions": {
            "jsx": "precompile",
            "jsxImportSource": "@lockness/hono"
        },
        "tasks": {
            "test": "deno test -A tests/",
            "test:watch": "deno test -A --watch tests/"
        }
    }
}
