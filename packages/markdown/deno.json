{
    "name": "@lockness/markdown",
    "description": "Markdown to JSX renderer with a plain-HTML default component map (styled output via @lockness/ui/markdown)",
    "version": "0.2.0",
    "license": "MIT",
    "exports": {
        ".": "./mod.tsx"
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "include": [
            "mod.tsx",
            "parser.ts",
            "renderer.tsx",
            "types.ts",
            "deno.json",
            "README.md"
        ],
        "exclude": [
            "tests/"
        ]
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@1",
        "@libs/markdown": "jsr:@libs/markdown@^2.1.0",
        "hono": "jsr:@lockness/hono@^0.2.0"
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "hono"
    }
}
