{
    "name": "@lockness/telemetry",
    "version": "0.4.0",
    "license": "MIT",
    "description": "OpenTelemetry span enrichment + framework metrics for Lockness, on Deno's built-in OTel (opt in with OTEL_DENO=1)",
    "exports": {
        ".": "./mod.ts"
    },
    "tasks": {
        "test": "deno test -A tests/"
    },
    "publish": {
        "exclude": [
            "tests/",
            "package.json",
            "tsconfig.json"
        ]
    },
    "imports": {
        "@lockness/contract": "jsr:@lockness/contract@^0.4.0",
        "@lockness/hono": "jsr:@lockness/hono@^0.4.0",
        "@opentelemetry/api": "npm:@opentelemetry/api@^1.9.1",
        "@std/assert": "jsr:@std/assert@1"
    }
}
