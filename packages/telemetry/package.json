{
    "name": "@lockness/telemetry",
    "version": "0.4.0",
    "description": "OpenTelemetry span enrichment + framework metrics for Lockness, on Deno's built-in OTel (opt in with OTEL_DENO=1)",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "lockness-source": "./mod.ts",
            "default": "./dist/mod.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "deno": ">=2.2"
    },
    "dependencies": {
        "@lockness/contract": "^0.4.0",
        "@lockness/hono": "^0.4.0",
        "@opentelemetry/api": "^1.9.1"
    },
    "lockness": {
        "jsr": {
            "@std/assert": "1"
        },
        "publish": {
            "exclude": [
                "tests/"
            ]
        },
        "tasks": {
            "test": "deno test -A tests/"
        }
    }
}
