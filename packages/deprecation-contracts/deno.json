{
    "name": "@lockness/deprecation-contracts",
    "version": "0.1.25",
    "license": "MIT",
    "exports": {
        ".": "./mod.ts",
        "./install": "./install.ts"
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "include": [
            "mod.ts",
            "decorators.ts",
            "install.ts",
            "deno.json",
            "README.md"
        ],
        "exclude": [
            "tests/"
        ]
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@1",
        "@lockness/container": "jsr:@lockness/container@^0.1.25",
        "@lockness/logger": "jsr:@lockness/logger@^0.1.25"
    },
    "description": "Generic deprecation notice system for triggering and managing feature deprecation warnings"
}
