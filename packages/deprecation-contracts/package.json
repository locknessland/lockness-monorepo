{
    "name": "@lockness/deprecation-contracts",
    "version": "0.4.0",
    "description": "Generic deprecation notice system for triggering and managing feature deprecation warnings",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "lockness-source": "./mod.ts",
            "default": "./dist/mod.js"
        },
        "./install": {
            "lockness-source": "./install.ts",
            "default": "./dist/install.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "deno": ">=2.2"
    },
    "dependencies": {
        "@lockness/cli": "^0.4.0"
    },
    "lockness": {
        "jsr": {
            "@std/assert": "1"
        },
        "publish": {
            "exclude": [
                "tests/"
            ]
        },
        "tasks": {
            "test": "deno test -A tests/",
            "test:watch": "deno test -A --watch tests/"
        }
    }
}
