{
    "name": "@lockness/hono",
    "version": "0.4.0",
    "description": "Hono bridge for Lockness framework providing centralized Hono dependency management across the ecosystem",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "lockness-source": "./mod.ts",
            "default": "./dist/mod.js"
        },
        "./types": {
            "lockness-source": "./types.ts",
            "default": "./dist/types.js"
        },
        "./http-exception": {
            "lockness-source": "./http_exception.ts",
            "default": "./dist/http_exception.js"
        },
        "./client": {
            "lockness-source": "./client.ts",
            "default": "./dist/client.js"
        },
        "./validator": {
            "lockness-source": "./validator.ts",
            "default": "./dist/validator.js"
        },
        "./jsx": {
            "lockness-source": "./jsx.ts",
            "default": "./dist/jsx.js"
        },
        "./jsx-runtime": {
            "lockness-source": "./jsx_runtime.ts",
            "default": "./dist/jsx_runtime.js"
        },
        "./jsx/jsx-runtime": {
            "lockness-source": "./jsx_runtime.ts",
            "default": "./dist/jsx_runtime.js"
        },
        "./jsx-renderer": {
            "lockness-source": "./jsx_renderer.ts",
            "default": "./dist/jsx_renderer.js"
        },
        "./deno": {
            "lockness-source": "./deno.ts",
            "default": "./dist/deno.js"
        },
        "./html": {
            "lockness-source": "./html.ts",
            "default": "./dist/html.js"
        },
        "./cookie": {
            "lockness-source": "./cookie.ts",
            "default": "./dist/cookie.js"
        },
        "./cors": {
            "lockness-source": "./cors.ts",
            "default": "./dist/cors.js"
        },
        "./zod-validator": {
            "lockness-source": "./zod_validator.ts",
            "default": "./dist/zod_validator.js"
        },
        "./auth": {
            "lockness-source": "./auth.ts",
            "default": "./dist/auth.js"
        },
        "./security": {
            "lockness-source": "./security.ts",
            "default": "./dist/security.js"
        },
        "./content": {
            "lockness-source": "./content.ts",
            "default": "./dist/content.js"
        },
        "./request": {
            "lockness-source": "./request.ts",
            "default": "./dist/request.js"
        },
        "./timing": {
            "lockness-source": "./timing.ts",
            "default": "./dist/timing.js"
        },
        "./routing": {
            "lockness-source": "./routing.ts",
            "default": "./dist/routing.js"
        },
        "./rendering": {
            "lockness-source": "./rendering.ts",
            "default": "./dist/rendering.js"
        },
        "./server": {
            "lockness-source": "./server.ts",
            "default": "./dist/server.js"
        },
        "./network": {
            "lockness-source": "./network.ts",
            "default": "./dist/network.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "deno": ">=2.2"
    },
    "dependencies": {
        "hono": "4.11.1",
        "hono-rate-limiter": "0.5.3",
        "@hono/zod-validator": "0.7.6"
    },
    "lockness": {
        "imports": {
            "hono/jsx": "hono/jsx",
            "hono/jsx-runtime": "hono/jsx/jsx-runtime",
            "hono/jsx-renderer": "hono/jsx-renderer",
            "hono/deno": "hono/deno",
            "hono/html": "hono/html",
            "hono/types": "hono/types",
            "hono/cookie": "hono/cookie",
            "hono/cors": "hono/cors",
            "hono/basic-auth": "hono/basic-auth",
            "hono/bearer-auth": "hono/bearer-auth",
            "hono/body-limit": "hono/body-limit",
            "hono/cache": "hono/cache",
            "hono/compress": "hono/compress",
            "hono/context-storage": "hono/context-storage",
            "hono/csrf": "hono/csrf",
            "hono/etag": "hono/etag",
            "hono/jwt": "hono/jwt",
            "hono/jwk": "hono/jwk",
            "hono/logger": "hono/logger",
            "hono/language": "hono/language",
            "hono/powered-by": "hono/powered-by",
            "hono/pretty-json": "hono/pretty-json",
            "hono/request-id": "hono/request-id",
            "hono/secure-headers": "hono/secure-headers",
            "hono/timeout": "hono/timeout",
            "hono/timing": "hono/timing",
            "hono/method-override": "hono/method-override",
            "hono/trailing-slash": "hono/trailing-slash",
            "hono/ip-restriction": "hono/ip-restriction",
            "hono/combine": "hono/combine",
            "hono/accepts": "hono/accepts",
            "hono/adapter": "hono/adapter",
            "hono/css": "hono/css",
            "hono/dev": "hono/dev",
            "hono/factory": "hono/factory",
            "hono/proxy": "hono/proxy",
            "hono/route": "hono/route",
            "hono/ssg": "hono/ssg",
            "hono/streaming": "hono/streaming",
            "hono/testing": "hono/testing",
            "hono/ws": "hono/ws",
            "hono/conninfo": "hono/conninfo",
            "hono/validator": "hono/validator",
            "hono/client": "hono/client",
            "hono/http-exception": "hono/http-exception",
            "hono/serve-static": "hono/serve-static"
        },
        "publish": {
            "exclude": [
                "tests/"
            ]
        }
    }
}
