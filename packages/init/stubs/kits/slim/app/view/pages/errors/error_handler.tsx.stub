/**
 * @fileoverview Error responses for {{ projectName }}, as JSON.
 *
 * Every route here answers JSON, so an error does too: without this file the
 * framework answers a 404 or a 500 with an HTML page, which a client expecting
 * JSON cannot read. The framework loads it from this exact path, which is why
 * a kit with no views has an `app/view/` folder at all — the `.tsx` extension
 * is part of that path, not a sign of JSX.
 *
 * Delete the file to get the HTML pages back.
 *
 * @module app/view/pages/errors/error_handler
 */

import {
    type Context,
    formatErrorForConsole,
    isExplicitlyDevelopment,
} from '@lockness/core'

/** Reason phrases for the client errors a JSON app meets most. */
const REASONS: Readonly<Record<number, string>> = {
    400: 'Bad Request',
    401: 'Unauthorized',
    403: 'Forbidden',
    404: 'Not Found',
    405: 'Method Not Allowed',
    409: 'Conflict',
    413: 'Content Too Large',
    415: 'Unsupported Media Type',
    422: 'Unprocessable Content',
    429: 'Too Many Requests',
}

/**
 * The HTTP status an error carries, or `undefined` when it carries none.
 *
 * Errors thrown by the framework or by your code may set `status`.
 */
function carriedStatus(error: Error): number | undefined {
    const status = (error as Error & { status?: unknown }).status
    return typeof status === 'number' && Number.isInteger(status) &&
            status >= 100 && status <= 599
        ? status
        : undefined
}

/**
 * Answer every error, and every unknown route, with a JSON body.
 *
 * A client error (4xx) keeps its status: it is the client's to fix, and the
 * status tells it how. Anything else answers 500 — a server fault's details
 * are not the client's business. The log line keeps the status the error
 * carried.
 *
 * The error's message is added only when `APP_ENV` is explicitly
 * `development`: an unset or unknown environment hides it, so an internal
 * detail never reaches a client by default.
 *
 * @param error - What was thrown, or a `Not Found` error for an unknown route.
 * @param c - The request context.
 * @returns `{ error, status }`, plus `message` in development.
 */
export const errorHandler = (error: Error, c: Context): Response => {
    const carried = carriedStatus(error)
    formatErrorForConsole(error, carried ?? 500, c.req.path)

    const status = carried !== undefined && carried >= 400 && carried < 500
        ? carried
        : 500
    const reason = status === 500
        ? 'Internal Server Error'
        : REASONS[status] ?? 'Client Error'
    const body: Record<string, unknown> = { error: reason, status }

    const showDetails = isExplicitlyDevelopment()
    if (showDetails) body.message = error.message
    return Response.json(body, { status })
}
