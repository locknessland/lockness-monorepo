/**
 * Smoke test — the app boots and answers.
 *
 * `app.fetch` is the whole application as a function, so this exercises
 * routing, the container and the middleware stack without opening a port.
 * Keep it: it is the test that tells you a bad import broke the boot, and it
 * runs in milliseconds.
 */

import { test } from 'node:test'
import { assertEquals } from '@std/assert'
import app from '../main.ts'

test('GET / answers', async () => {
    const response = await app.fetch(new Request('http://localhost/'))

    assertEquals(response.status, 200)
    assertEquals((await response.json()).app, '{{ projectName }}')
})

test('GET /hello runs its named middleware', async () => {
    const response = await app.fetch(new Request('http://localhost/hello'))

    assertEquals(response.status, 200)
    // Set by ExampleMiddleware — if the middleware did not run, the route
    // falls back to 'world' and this fails.
    assertEquals(
        (await response.json()).hello,
        'world, from a named middleware',
    )
})

test('an unknown route is a JSON 404, not a crash', async () => {
    const response = await app.fetch(new Request('http://localhost/nope'))

    assertEquals(response.status, 404)
    // Answered by app/view/pages/errors/error_handler.tsx — if it did not
    // load, the framework's HTML page comes back and this fails.
    assertEquals((await response.json()).error, 'Not Found')
})
