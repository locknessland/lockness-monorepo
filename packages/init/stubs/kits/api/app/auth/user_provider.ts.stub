/**
 * @fileoverview How the token guard finds a user.
 *
 * `DrizzleTokenProvider` from `@lockness/auth-provider` does the token work —
 * generation, hashing, storage, expiry, revocation — in the `accessTokens`
 * table it is handed. It does not know your users, so the two user lookups
 * are supplied here. Those, and the table, are the whole of the wiring.
 *
 * @module app/auth/user_provider
 */

import { eq } from 'drizzle-orm'
import type { PostgresJsDatabase } from 'drizzle-orm/postgres-js'
// The Drizzle adapter is a SUBPATH export: the package root carries only
// the ORM-agnostic bases, so that a Kysely project never loads Drizzle.
import { DrizzleTokenProvider } from '@lockness/auth-provider/drizzle'
import { verifyPassword } from '@lockness/auth'
import type { Database } from '@lockness/drizzle'
import { accessTokens, users } from '@model/user.ts'

/** The user shape the guard hands back to a controller. */
export interface ApiUser extends Record<string, unknown> {
    id: number
    email: string
    name: string | null
}

type Db = PostgresJsDatabase<Record<string, unknown>>

/**
 * Build the provider the `api` guard authenticates against.
 *
 * @param database - The `Database` service from the container. Its handle
 * is read on each lookup, not here: a guard builds this provider on every
 * request, and `database.db` throws while no database is connected.
 * @returns A provider bound to this application's `users` and
 * `access_tokens` tables.
 *
 * @example
 * ```ts
 * const provider = createUserProvider(container.get<Database>(Database))
 * ```
 */
export function createUserProvider(
    database: Database,
): DrizzleTokenProvider<ApiUser> {
    return new DrizzleTokenProvider<ApiUser>({
        // A function, called per lookup: building the provider touches no
        // database, so a page that needs no user renders without one.
        db: (): Db => database.db,
        // The table OBJECT, not its name: the provider builds its queries
        // from these columns, and refuses a table that lacks one.
        tokensTable: accessTokens,

        findUserById: async (db: Db, id: string | number) => {
            const rows = await db.select().from(users)
                .where(eq(users.id, Number(id))).limit(1)
            return rows.length > 0 ? toApiUser(rows[0]) : null
        },

        findUserByCredentials: async (
            db: Db,
            email: string,
            password: string,
        ) => {
            const rows = await db.select().from(users)
                .where(eq(users.email, email)).limit(1)
            if (rows.length === 0) return null

            // Compared with a constant-time hash check, never with `===`.
            const ok = await verifyPassword(password, rows[0].password)
            return ok ? toApiUser(rows[0]) : null
        },
    })
}

/**
 * Narrow a row to what a caller may see.
 *
 * The password hash never leaves this module — a provider that returns the
 * whole row hands it to every handler, and from there to a JSON response.
 */
function toApiUser(row: typeof users.$inferSelect): ApiUser {
    return { id: row.id, email: row.email, name: row.name }
}
