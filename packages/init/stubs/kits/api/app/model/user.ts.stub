import {
    index,
    integer,
    pgTable,
    serial,
    text,
    timestamp,
} from 'drizzle-orm/pg-core'

/**
 * The users table.
 *
 * `password` is a **hash**, never a password. `deno task cli make:model` will
 * scaffold further tables in this shape.
 *
 * Every login looks a user up by email, and the UNIQUE constraint on `email`
 * already indexes it — no second index is needed.
 *
 * This schema is the source of truth. `database/migrations/` was generated
 * from it with `drizzle-kit generate`; change the schema, then run
 * `deno task cli db:generate` for the next migration.
 */
export const users = pgTable('users', {
    id: serial('id').primaryKey(),
    email: text('email').notNull().unique(),
    password: text('password').notNull(),
    name: text('name'),
    createdAt: timestamp('created_at').defaultNow(),
    updatedAt: timestamp('updated_at').defaultNow(),
})

/**
 * Issued access tokens.
 *
 * Only the **hash** of a token is stored. The plaintext is returned once, at
 * creation, and is unrecoverable afterwards — a leaked database is then not a
 * set of working credentials.
 *
 * Every authenticated request looks a token up by its hash, so that lookup is
 * on the hot path; the UNIQUE constraint on `token` already indexes it. A
 * token belongs to one user and goes with them: deleting the user cascades to
 * their tokens, and `access_tokens_user_id_idx` keeps "this user's tokens"
 * (and that cascade) from scanning the table.
 */
export const accessTokens = pgTable('access_tokens', {
    id: serial('id').primaryKey(),
    userId: integer('user_id').notNull().references(() => users.id, {
        onDelete: 'cascade',
    }),
    name: text('name').notNull(),
    token: text('token').notNull().unique(),
    expiresAt: timestamp('expires_at'),
    createdAt: timestamp('created_at').defaultNow(),
}, (table) => [index('access_tokens_user_id_idx').on(table.userId)])

/** A row as it comes back from a select. */
export type User = typeof users.$inferSelect
/** A row as it goes into an insert. */
export type NewUser = typeof users.$inferInsert
