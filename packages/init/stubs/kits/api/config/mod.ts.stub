/**
 * Application Configuration
 *
 * Central export point. The api kit ships five namespaces; add one as you add
 * the package that needs it.
 *
 * @module config
 */

import { appConfig } from './app.ts'
import { cacheConfig } from './cache.ts'
import { compileConfig } from './compile.ts'
import { databaseConfig } from './database.ts'
import { listeners } from './listeners.ts'

/** Centralized configuration object with typed namespaces. */
export const config = {
    app: appConfig,
    cache: cacheConfig,
    compile: compileConfig,
    database: databaseConfig,
    listeners,
} as const

/** Check if running in development mode */
export const isDevelopment = config.app.env === 'development'

/** Check if running in production mode */
export const isProduction = config.app.env === 'production'
