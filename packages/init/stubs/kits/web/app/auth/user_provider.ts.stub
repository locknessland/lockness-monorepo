/**
 * @fileoverview How the session guard finds a user.
 *
 * `DrizzleSessionProvider` from `@lockness/auth-provider` does the session
 * work. It does not know your schema, so the two lookups it needs are supplied
 * here. That is the whole of the wiring.
 *
 * @module app/auth/user_provider
 */

import { eq } from 'drizzle-orm'
import type { PostgresJsDatabase } from 'drizzle-orm/postgres-js'
// The Drizzle adapter is a SUBPATH export: the package root carries only the
// ORM-agnostic bases, so that a Kysely project never loads Drizzle.
import { DrizzleSessionProvider } from '@lockness/auth-provider/drizzle'
import { verifyPassword } from '@lockness/auth'
import type { Database } from '@lockness/drizzle'
import { users } from '@model/user.ts'

/** The user shape handed to a controller and a view. */
export interface WebUser extends Record<string, unknown> {
    id: number
    email: string
    name: string | null
}

type Db = PostgresJsDatabase<Record<string, unknown>>

/**
 * Build the provider the `web` guard authenticates against.
 *
 * @param database - The `Database` service from the container. Its handle
 * is read on each lookup, not here: a guard builds this provider on every
 * request, and `database.db` throws while no database is connected.
 * @returns A provider bound to this application's `users` table.
 */
export function createUserProvider(
    database: Database,
): DrizzleSessionProvider<WebUser> {
    return new DrizzleSessionProvider<WebUser>({
        // A function, called per lookup: building the provider touches no
        // database, so a page that needs no user renders without one.
        db: (): Db => database.db,

        findUserById: async (db: Db, id: string | number) => {
            const rows = await db.select().from(users)
                .where(eq(users.id, Number(id))).limit(1)
            return rows.length > 0 ? toWebUser(rows[0]) : null
        },

        findUserByCredentials: async (
            db: Db,
            email: string,
            password: string,
        ) => {
            const rows = await db.select().from(users)
                .where(eq(users.email, email)).limit(1)
            if (rows.length === 0) return null

            // Compared with a constant-time hash check, never with `===`.
            const ok = await verifyPassword(password, rows[0].password)
            return ok ? toWebUser(rows[0]) : null
        },
    })
}

/**
 * Narrow a row to what a caller may see.
 *
 * The password hash never leaves this module — a provider that returns the
 * whole row hands it to every handler, and from there into a rendered page.
 */
function toWebUser(row: typeof users.$inferSelect): WebUser {
    return { id: row.id, email: row.email, name: row.name }
}
