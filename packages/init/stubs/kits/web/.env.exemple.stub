APP_ENV=development
PORT=8888

# Application key. Generated for you in .env when the project was
# scaffolded; this example file deliberately carries none, because it is
# committed and a key committed is a key everybody has.
APP_KEY=

# Database. Left unset on purpose: the app boots without it, and only the
# routes that read the database fail. Set it, then `deno task db:migrate`.
# DATABASE_URL=postgres://username:password@localhost:5432/{{ projectName }}

# Debug Toolbar
DEBUG_BAR=true
