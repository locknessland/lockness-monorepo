/**
 * @fileoverview Application Kernel - Bootstrap and Configuration
 *
 * This is your application's kernel - the central configuration file
 * that sets up middleware, authentication, and other core features.
 *
 * Uses the declarative @Kernel decorator approach for cleaner configuration.
 * Configuration is externalized in the `config/` directory for better organization.
 *
 * @module app/kernel
 */

import { type App, DeclareGlobalMiddleware, Kernel, OnBoot } from '@lockness/core'
import { controllers } from './routes.ts'
import { config } from '../config/mod.ts'

/**
 * Application Kernel with Declarative Configuration
 *
 * This kernel configures your {{ projectName }} application using the @Kernel decorator.
 * Configuration files are located in the `config/` directory:
 *
 * - `config/app.ts` - General application settings
 * - `config/database.ts` - Database connection
 * - `config/session.ts` - Session management
 * - `config/mod.ts` - Central export point
 *
 * @example Start the application
 * ```typescript
 * import { createApp } from '@lockness/core'
 * import { AppKernel } from './app/kernel.ts'
 *
 * const app = await createApp(AppKernel)
 * app.listen(8888)
 * ```
 */
@Kernel({
    // Static files directory
    staticDir: 'public',

    // Controllers configuration
    // Development: auto-discovery from directory
    // Production: uses explicit controllers list
    controllersDir: './app/controller',
    controllers: controllers,

    // Uncomment when you add database support:
    // database: config.database,

    // Uncomment when you add session support:
    // session: config.session,

    // Uncomment when you add cache support:
    // cache: config.cache,

    // Binary compilation configuration
    // See config/compile.ts for configuration
    compile: config.compile,
})
export class AppKernel {
    /**
     * Global Middleware Stack
     *
     * Add middlewares that should run on every request.
     * They execute in array order.
     *
     * @example Add session and auth:
     * ```typescript
     * import { sessionMiddleware } from '@lockness/session'
     * import { authConfig } from './auth/guards.ts'
     *
     * globalMiddlewares = [
     *     sessionMiddleware(),
     *     initializeAuthMiddleware(authConfig),
     *     LoggerMiddleware,
     * ]
     * ```
     */
    @DeclareGlobalMiddleware()
    globalMiddlewares: unknown[] = [
        // Add your global middlewares here
    ]
}

/**
 * ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 * CONFIGURATION EXAMPLES - Add features as your application grows
 * ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 *
 * Configuration files are already created in `config/` directory:
 *
 *    config/
 *    ├── mod.ts          # Central export point
 *    ├── app.ts          # App settings (isDevelopment, isProduction)
 *    ├── database.ts     # Database connection
 *    ├── session.ts      # Session management
 *    ├── cache.ts        # Cache configuration
 *    └── compile.ts      # Binary compilation config
 *
 * Just uncomment the relevant @Kernel options above to enable features!
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * 1. AUTHENTICATION (with externalized guards)
 * ─────────────────────────────────────────────────────────────────────────────
 *
 *    // app/auth/guards.ts
 *    import { container } from '@lockness/container'
 *    import { Database } from '@lockness/drizzle'
 *    import { type AuthConfig, SessionGuard } from '@lockness/auth'
 *    import { UserProvider } from './user_provider.ts'
 *
 *    export function createWebGuard(ctx: Context) {
 *        const db = container.get<Database>(Database)
 *        return new SessionGuard('web', ctx, new UserProvider(db))
 *    }
 *
 *    export const authConfig: AuthConfig = {
 *        default: 'web',
 *        guards: { web: createWebGuard },
 *    }
 *
 *    // app/kernel.ts
 *    import { authConfig } from './auth/guards.ts'
 *
 *    @DeclareGlobalMiddleware()
 *    globalMiddlewares = [
 *        sessionMiddleware(),
 *        initializeAuthMiddleware(authConfig),
 *    ]
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * 2. NAMED MIDDLEWARES (route-level)
 * ─────────────────────────────────────────────────────────────────────────────
 *
 *    @Kernel({
 *        middlewaresDir: './app/middleware', // Auto-discovers @DeclareMiddleware
 *    })
 *
 *    // app/middleware/auth_middleware.ts
 *    @DeclareMiddleware('auth')
 *    export class AuthMiddleware {
 *        async handle(c: Context, next: Next) {
 *            return await next()
 *        }
 *    }
 *
 *    // Use in controllers: @UseMiddleware('auth')
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * 3. MOUNT POINTS (i18n, API versioning, multi-tenancy)
 * ─────────────────────────────────────────────────────────────────────────────
 *
 *    Mount point configuration is externalized in config/routing.ts:
 *
 *    // config/routing.ts
 *    import type { MountPoint } from '@lockness/core'
 *    import { i18nMiddleware } from '../app/middleware/i18n_middleware.ts'
 *
 *    export const mountPointConfig: MountPoint = {
 *        pattern: '/:langId/:countryId',
 *        middleware: i18nMiddleware,
 *    }
 *
 *    // app/kernel.ts
 *    import { config } from '../config/mod.ts'
 *
 *    @Kernel({
 *        mountPoint: config.routing,
 *    })
 *
 *    // Routes accessible at:
 *    // - /products (root, no locale)
 *    // - /fr/ca/products (with locale context)
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * 4. DEVTOOLS (development only)
 * ─────────────────────────────────────────────────────────────────────────────
 *
 *    import { collectAppRoutes } from '@lockness/devtools'
 *
 *    @Kernel({ devtools: true })
 *    export class AppKernel {
 *        @OnBoot()
 *        collectDevtoolsRoutes(app: App) {
 *            if (app.isDevelopment) {
 *                collectAppRoutes(app)
 *            }
 *        }
 *    }
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * 5. BOOT HOOKS (startup lifecycle)
 * ─────────────────────────────────────────────────────────────────────────────
 *
 *    @OnBoot({ priority: 100 }) // Higher priority runs first
 *    async setupDatabase(app: App) {
 *        console.log('Database ready!')
 *    }
 *
 *    @OnBoot({ priority: 50 })
 *    async seedData(app: App) {
 *        if (app.isDevelopment) {
 *            await runSeeders()
 *        }
 *    }
 */
