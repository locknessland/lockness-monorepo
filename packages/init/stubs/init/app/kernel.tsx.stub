import {
    App,
} from '@lockness/core'
import { controllers } from './routes.ts'

/**
 * Bootstrap the {{ projectName }} application
 *
 * This is your application's kernel - the central configuration file
 * that sets up middleware, authentication, and other core features.
 *
 * Start simple and add features as you need them!
 */
export const bootstrap = async () => {
    // Create Lockness application
    const app = new App()

    // Initialize with controllers (auto-discovery in dev, explicit in prod)
    await app.init({
        controllersDir: app.isDevelopment ? './app/controller' : undefined,
        controllers: app.isDevelopment ? undefined : controllers,
        staticDir: 'public',
    })

    return app
}

/**
 * Configuration Examples - Add features as you need them:
 *
 * 1. Add Session Management (for traditional web apps):
 * 
 *    import { configureSession, sessionMiddleware } from '@lockness/session'
 *    
 *    configureSession({
 *        driver: 'cookie', // 'cookie' | 'deno-kv' | 'memory'
 *        secret: Deno.env.get('APP_KEY') || 'change-me-in-production',
 *        lifetime: 7200, // 2 hours
 *        secure: Deno.env.get('APP_ENV') === 'production',
 *    })
 *    
 *    app.useMiddleware(
 *        sessionMiddleware(), // Add before auth if using session-based auth
 *    )
 *
 * 2. Add Authentication (session-based or JWT):
 * 
 *    import { initializeAuthMiddleware, SessionGuard } from '@lockness/auth'
 *    import { UserProvider } from '@auth/user_provider.ts'
 *    
 *    app.useMiddleware(
 *        initializeAuthMiddleware({
 *            default: 'web',
 *            guards: {
 *                web: (ctx) => new SessionGuard('web', ctx, new UserProvider()),
 *            },
 *        })
 *    )
 *    
 *    // Then use named middleware:
 *    await app.init({
 *        middlewares: {
 *            auth: class AuthMiddleware {
 *                async handle(c: import('@lockness/core').Context, next: import('@lockness/core').Next) {
 *                    // Your auth logic or import from @lockness/auth
 *                    return await next()
 *                }
 *            },
 *        },
 *    })
 *
 * 3. Add Global Middleware (CORS, logging, etc.):
 * 
 *    import { cors, logger } from '@lockness/core' // Hono middleware
 *    
 *    app.useMiddleware(
 *        logger(),
 *        cors({
 *            origin: ['http://localhost:3000'],
 *            credentials: true,
 *        })
 *    )
 *
 * 4. Customize error pages (auto-discovered):
 * 
 *    Run: deno task cli make:error-pages
 *    This creates app/view/pages/errors/error_handler.tsx
 *    The framework will automatically use it - no import needed!
 *
 * 5. Enable devtools in development:
 * 
 *    import { enableDevtools } from '@lockness/devtools'
 *    if (app.isDevelopment) {
 *        enableDevtools(app.getHono())
 *    }
 */
