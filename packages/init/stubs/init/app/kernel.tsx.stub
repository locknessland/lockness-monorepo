import {
    App,
    configureSession,
    sessionMiddleware,
} from '@lockness/core'
import {
    authMiddleware,
} from '@lockness/auth'
import { controllers } from './routes.ts'

/**
 * Bootstrap the {{ projectName }} application
 *
 * This is your application's kernel - the central configuration file
 * that sets up middleware, authentication, sessions, and other core features.
 *
 * Start simple and add features as you need them!
 */
export const bootstrap = async () => {
    // Configure session (optional - defaults to cookie driver)
    configureSession({
        driver: 'cookie', // 'cookie' | 'deno-kv' | 'memory'
        secret: Deno.env.get('APP_KEY') || 'change-me-in-production',
        lifetime: 7200, // 2 hours
        secure: Deno.env.get('APP_ENV') === 'production',
    })

    // Create Lockness application
    const app = new App()

    // Configure global middlewares using fluent API
    app.useMiddleware(
        sessionMiddleware(), // Session middleware (required for auth)
        // Add more global middlewares here
        // LoggerMiddleware,
    )

    // Initialize with controllers (auto-discovery in dev, explicit in prod)
    await app.init({
        controllersDir: app.isDevelopment ? './app/controller' : undefined,
        controllers: app.isDevelopment ? undefined : controllers,
        staticDir: 'public',

        // Named middlewares (use with @Use('auth'))
        middlewares: {
            auth: class AuthMiddleware {
                async handle(
                    c: import('@lockness/core').Context,
                    next: import('@lockness/core').Next,
                ) {
                    return await authMiddleware()(c, next)
                }
            },
        },
    })

    return app
}

/**
 * Advanced Configuration Examples:
 *
 * 1. Add custom error pages:
 * 
 *    import { errorHandler } from '@view/pages/errors/mod.ts'
 *    app.useErrorHandler(errorHandler)
 *
 * 2. Add authentication (requires UserProvider):
 * 
 *    import { initializeAuthMiddleware, SessionGuard } from '@lockness/auth'
 *    import { UserProvider } from '@auth/user_provider.ts'
 *    
 *    app.useMiddleware(
 *        initializeAuthMiddleware({
 *            default: 'web',
 *            guards: {
 *                web: (ctx) => new SessionGuard('web', ctx, new UserProvider()),
 *            },
 *        })
 *    )
 *
 * 3. Enable devtools in development:
 * 
 *    import { enableDevtools } from '@lockness/devtools'
 *    if (app.isDevelopment) {
 *        enableDevtools(app.getHono())
 *    }
 */
