# Dependencies
node_modules/
.npm/

# Build outputs
dist/
_dist/
_output/
.compiled/
coverage/

# Development files
.git/
.gitignore
.vscode/
*.md
!README.md

# Environment files and key material (secrets): `COPY . .` would bake them
# into an image layer. Pass them at run time instead (--env-file).
# `**/` makes each pattern match at any depth: Docker matches .dockerignore
# from the context root only, so a bare `.env*` misses config/.env.production.
**/.env*
!**/.env.exemple
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.pfx

# Test files
tests/
*.test.ts
*.spec.ts

# IDE
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Temporary files
*.tmp
*.temp
.cache/
