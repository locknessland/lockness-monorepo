{
    "workspace": [],
    "nodeModulesDir": "auto",
    "tasks": {
        "dev": "bash scripts/dev.sh",
        "build": "deno task css:build",
        "start": "deno run -A --env-file=.env.production.local main.ts",
        "cli": "deno run -A --env cli.ts",
        "css:build": "deno run -A npm:postcss-cli@11 app/view/assets/app.css -o public/css/app.css",
        "css:watch": "deno run -A npm:postcss-cli@11 app/view/assets/app.css -o public/css/app.css --watch",
        "routes:generate": "deno run -A scripts/generate_routes.ts",
        "routes:watch": "deno run -A scripts/watch_routes.ts",
        "test": "deno test -A"
    },
    "imports": {
        "@/": "./",
        "@controller/": "./app/controller/",
        "@service/": "./app/service/",
        "@middleware/": "./app/middleware/",
        "@model/": "./app/model/",
        "@repository/": "./app/repository/",
        "@view/": "./app/view/",
        "@kernel": "./app/kernel.tsx",
        "@std/assert": "jsr:@std/assert@1",
        "@std/cli": "jsr:@std/cli@1",
        "@std/fs": "jsr:@std/fs@1",
        "@std/path": "jsr:@std/path@1",
        "@lockness/core": "jsr:@lockness/core@^0.1.19",
        "@lockness/cli": "jsr:@lockness/cli@^0.1.19",
        "@lockness/auth": "jsr:@lockness/auth@^0.1.19",
        "postcss": "npm:postcss@^8.4.49",
        "postcss-cli": "npm:postcss-cli@^11.0.0"
    },
    "unstable": [
        "kv"
    ],
    "fmt": {
        "indentWidth": 4,
        "useTabs": false,
        "singleQuote": true,
        "proseWrap": "always",
        "lineWidth": 80,
        "semiColons": false
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "@lockness/core"
    }
}
