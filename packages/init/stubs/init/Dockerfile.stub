# ============================================================================
# Lockness JS - Production Dockerfile
# Single stage: the app runs with `deno run`, so the image needs Deno anyway.
#
# Build: docker build -t my-app .
# Run:   docker run -p 8888:8888 --env-file .env.production.local my-app
#
# Override Deno version: docker build --build-arg DENO_VERSION=2.9.6 -t my-app .
# Use a JSR mirror:      docker build --build-arg JSR_URL=https://<mirror> -t my-app .
#
# Commit deno.lock: without it the build resolves dependencies afresh, and
# Deno's minimum dependency age can pick the previous release of a package.
# ============================================================================

# Deno version - can be overridden at build time
ARG DENO_VERSION=2.9.6
FROM denoland/deno:${DENO_VERSION}

# Registry the build resolves jsr: specifiers from. The running container keeps
# it (ENV below): Deno keys its module cache by registry origin, so a
# --cached-only start finds the modules only under the registry they came from.
# Never put credentials in it: it persists in the image config. For a private
# mirror, give DENO_AUTH_TOKENS to the `deno install` steps through a BuildKit
# secret mount (RUN --mount=type=secret,...), never as an ARG or ENV.
ARG JSR_URL=https://jsr.io

WORKDIR /app

# Dependencies first, so editing the app does not re-download them
COPY deno.json deno.lock* ./
RUN deno install

# The app, then its build step (route registry, CSS), then every module the
# entrypoint loads, so the server starts without fetching anything
COPY . .
RUN deno task build && deno install --entrypoint main.ts

# The base image's unprivileged user. The app tree stays owned by root, so the
# running process cannot rewrite its own code.
USER deno

# Expose the application port
EXPOSE 8888

# Health check — liveness only, so it polls /health and never /ready.
# It must track whether the process is up and nothing else: /health touches no
# dependency. /ready probes the database: polled from here it would wake a
# scale-to-zero database on every interval, and flag a healthy process whenever
# the database is briefly unavailable. /ready belongs to a load balancer or an
# orchestrator readiness gate.
# An unhealthy container is only marked unhealthy by plain Docker and Compose;
# Swarm replaces it; Kubernetes ignores HEALTHCHECK, so point its liveness
# probe at /health.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD deno eval "const r = await fetch('http://localhost:${PORT:-8888}/health'); if (!r.ok) Deno.exit(1);" || exit 1

# Set after the build steps, so `deno task build` runs in development mode
ENV APP_ENV=production
ENV PORT=8888
ENV JSR_URL=${JSR_URL}

# Run the server. --cached-only: everything was fetched at build time, and the
# running container must never reach a registry.
CMD ["deno", "run", "--cached-only", "--allow-net", "--allow-read", "--allow-env", "--allow-sys", "main.ts"]
