APP_ENV=development
PORT=8888

# Database Configuration
DATABASE_URL=postgres://username:password@localhost:5432/{{projectName}}
DATABASE_KV_PATH=./data/cache.db

# Application key. Generated for you in .env when the project was
# scaffolded; this example file deliberately carries none, because it is
# committed and a key committed is a key everybody has.
APP_KEY=

# Mail Configuration
MAIL_DRIVER=console
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="{{projectName}}"

# SMTP (if MAIL_DRIVER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASS=your-password

# Resend (if MAIL_DRIVER=resend)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Queue Configuration
QUEUE_DRIVER=memory
# QUEUE_DRIVER=deno-kv

# Debug Toolbar
DEBUG_BAR=true
