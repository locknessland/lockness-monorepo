{
    "name": "@lockness/testing",
    "version": "0.3.0",
    "license": "MIT",
    "exports": "./mod.ts",
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "exclude": [
            "tests/"
        ]
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@1",
        "@lockness/hono": "jsr:@lockness/hono@^0.3.0",
        "hono": "jsr:@lockness/hono@^0.3.0",
        "@lockness/auth": "jsr:@lockness/auth@^0.3.0"
    },
    "description": "Test-support harness for Lockness applications \u2014 HTTP test client, actingAs, fakes and DB assertions. Import it from your tests only; nothing here is meant to run in production."
}
