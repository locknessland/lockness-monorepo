{
    "name": "@lockness/queue",
    "version": "0.4.0",
    "license": "MIT",
    "description": "Background job processing system with multiple drivers (Memory, Deno KV, Redis), automatic retries with a dead-letter queue and retry command, and delayed execution",
    "exports": {
        ".": "./mod.ts"
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "exclude": [
            "tests/",
            "package.json",
            "tsconfig.json"
        ]
    },
    "imports": {
        "@lockness/contract": "jsr:@lockness/contract@^0.4.0",
        "@lockness/redis": "jsr:@lockness/redis@^0.4.0",
        "@std/assert": "jsr:@std/assert@1"
    }
}
