{
    "name": "@lockness/scheduler",
    "version": "0.4.0",
    "license": "MIT",
    "description": "Declarative cron-based task scheduling with the @Schedule decorator, presets, retries and graceful stop",
    "exports": {
        ".": "./mod.ts"
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "exclude": [
            "tests/",
            "package.json",
            "tsconfig.json"
        ]
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@1",
        "@std/testing": "jsr:@std/testing@^1.0.0",
        "@lockness/contract": "jsr:@lockness/contract@^0.4.0",
        "@lockness/container": "jsr:@lockness/container@^0.4.0"
    }
}
