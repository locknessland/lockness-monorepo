{
    "name": "@lockness/mail",
    "version": "0.4.0",
    "license": "MIT",
    "description": "Expressive email sending library with multiple driver support (SMTP, Resend, Console, Memory) and fluent API",
    "exports": {
        ".": "./mod.ts"
    },
    "tasks": {
        "test": "deno test -A tests/",
        "test:watch": "deno test -A --watch tests/"
    },
    "publish": {
        "exclude": [
            "tests/",
            "package.json",
            "tsconfig.json"
        ]
    },
    "imports": {
        "@lockness/contract": "jsr:@lockness/contract@^0.4.0",
        "@std/path": "jsr:@std/path@1",
        "@std/assert": "jsr:@std/assert@1",
        "@lockness/cli": "jsr:@lockness/cli@^0.4.0"
    }
}
