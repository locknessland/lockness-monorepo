{
    "workspace": [
        "./lockness/core",
        "./lockness/ace",
        "./lockness/kysely",
        "./lockness/init"
    ],
    "nodeModulesDir": "none",
    "tasks": {
        "dev": "VITE=true deno run -A --env --node-modules-dir npm:vite dev",
        "build": "deno run -A --node-modules-dir npm:vite build",
        "preview": "deno run -A --node-modules-dir npm:vite preview",
        "start": "deno run --allow-net --allow-read --allow-env --allow-sys --allow-run --env-file=.env.production.local dist/server.js",
        "compile": "deno compile --allow-all --output lockness-server dist/server.js",
        "ace": "deno run -A ace.ts"
    },
    "imports": {
        "@/": "./",
        "@controller/": "./src/controller/",
        "@service/": "./src/service/",
        "@middleware/": "./src/middleware/",
        "@model/": "./src/model/",
        "@router": "./src/router.ts",
        "@repository/": "./src/repository/",
        "@kernel": "./src/kernel.ts",
        "@std/assert": "jsr:@std/assert@1",
        "@std/cli": "jsr:@std/cli@1",
        "@std/fs": "jsr:@std/fs@1",
        "@std/path": "jsr:@std/path@1",
        "lockness": "./lockness/core/core.ts",
        "@lockness/core": "./lockness/core/core.ts",
        "@lockness/ace": "./lockness/ace/cli.ts",
        "@lockness/kysely": "./lockness/kysely/database.ts",
        "hono": "npm:hono@^4.11.1",
        "hono/": "npm:/hono@^4.11.1/",
        "postgres": "npm:postgres@^3.4.4",
        "kysely": "npm:kysely@^0.28.9",
        "kysely-postgres-js": "npm:kysely-postgres-js@^2.0.0",
        "vite": "npm:vite@^5.0.0",
        "@hono/vite-dev-server": "npm:@hono/vite-dev-server@^0.12.0",
        "@hono/zod-validator": "npm:@hono/zod-validator@^0.4.1",
        "zod": "npm:zod@^3.23.8"
    },

    "unstable": [
        "kv"
    ],
    "fmt": {
        "indentWidth": 4,
        "useTabs": false,
        "singleQuote": true,
        "proseWrap": "always",
        "lineWidth": 80,
        "semiColons": false
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "hono/jsx"
    }
}
