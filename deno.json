{
    "tasks": {
        "dev": "deno run --env-file=.env -A --watch main.ts",
        "build": "deno run -A scripts/build.ts",
        "start": "deno run --allow-net --allow-env _output/server.ts",
        "compile": "deno compile --allow-read --allow-net --allow-env --output _output/server main.ts",
        "ace": "deno run -A ace.ts"
    },
    "imports": {
        "@/": "./",
        "@controller/": "./src/controller/",
        "@service/": "./src/service/",
        "@middleware/": "./src/middleware/",
        "@model/": "./src/model/",
        "@router": "./src/router.ts",
        "@repository/": "./src/repository/",
        "@kernel": "./src/kernel.ts",
        "@std/assert": "jsr:@std/assert@1",
        "lockness": "./lockness/core.ts",
        "hono": "npm:hono@^4.11.1"
    },
    "unstable": [
        "kv"
    ],
    "fmt": {
        "indentWidth": 4,
        "useTabs": false,
        "singleQuote": true,
        "proseWrap": "always",
        "lineWidth": 80,
        "semiColons": false
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "hono/jsx"
    }   
}
