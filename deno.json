{
    "workspace": [
        "./lockness/core",
        "./lockness/ace",
        "./lockness/drizzle",
        "./lockness/init"
    ],
    "nodeModulesDir": "auto",
    "tasks": {
        "dev": "VITE=true deno run -A --env npm:vite dev",
        "build": "deno run -A npm:vite build && deno run -A npm:vite build --ssr",
        "preview": "deno run -A npm:vite preview",
        "start": "deno run --allow-net --allow-read --allow-env --allow-sys --allow-run --env-file=.env.production.local dist/server.js",
        "compile": "deno compile --allow-all --output lockness-server dist/server.js",
        "ace": "deno run -A --env ace.ts",
        "test": "deno test -A --env lockness/",
        "test:coverage": "rm -rf coverage && deno test -A --env --coverage=coverage lockness/ && deno coverage coverage --lcov > coverage/lcov.info && rm -f coverage/*.json",
        "test:watch": "deno test -A --env --watch lockness/",
        "test:ace": "cd lockness/ace && deno task test",
        "test:core": "cd lockness/core && deno task test"
    },
    "imports": {
        "@/": "./",
        "@controller/": "./src/controller/",
        "@service/": "./src/service/",
        "@middleware/": "./src/middleware/",
        "@model/": "./src/model/",
        "@router": "./src/router.ts",
        "@repository/": "./src/repository/",
        "@kernel": "./src/kernel.ts",
        "@std/assert": "jsr:@std/assert@1",
        "@std/cli": "jsr:@std/cli@1",
        "@std/fs": "jsr:@std/fs@1",
        "@std/path": "jsr:@std/path@1",
        "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.18",
        "lockness": "./lockness/core/core.ts",
        "@lockness/core": "./lockness/core/core.ts",
        "@lockness/ace": "./lockness/ace/cli.ts",
        "@lockness/drizzle": "./lockness/drizzle/database.ts",
        "hono": "npm:hono@^4.11.1",
        "hono/": "npm:/hono@^4.11.1/",
        "postgres": "npm:postgres@^3.4.4",
        "drizzle-orm": "npm:drizzle-orm@^0.36.3",
        "drizzle-zod": "npm:drizzle-zod@^0.5.1",
        "drizzle-kit": "npm:drizzle-kit@^0.27.2",
        "tailwindcss": "npm:tailwindcss@^4.1.18",
        "tw-animate-css": "npm:tw-animate-css@^1.4.0",
        "vite": "npm:vite@^5.0.0",
        "@hono/vite-dev-server": "npm:@hono/vite-dev-server@^0.12.0",
        "@hono/zod-validator": "npm:@hono/zod-validator@^0.4.1",
        "zod": "npm:zod@^3.23.8"
    },

    "unstable": [
        "kv"
    ],
    "fmt": {
        "indentWidth": 4,
        "useTabs": false,
        "singleQuote": true,
        "proseWrap": "always",
        "lineWidth": 80,
        "semiColons": false
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "hono/jsx",
        "experimentalDecorators": true
    }
}
