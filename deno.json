{
    "workspace": [
        "./lockness/core",
        "./lockness/ace",
        "./lockness/drizzle",
        "./lockness/init"
    ],
    "nodeModulesDir": "auto",
    "tasks": {
        "dev": "deno run --env-file=.env -A --watch main.ts",
        "build": "deno run -A scripts/build.ts",
        "start": "deno run --allow-net --allow-env _output/server.ts",
        "compile": "deno compile --allow-read --allow-net --allow-env --output _output/server main.ts",
        "ace": "deno run -A ace.ts"
    },
    "imports": {
        "@/": "./",
        "@controller/": "./src/controller/",
        "@service/": "./src/service/",
        "@middleware/": "./src/middleware/",
        "@model/": "./src/model/",
        "@router": "./src/router.ts",
        "@repository/": "./src/repository/",
        "@kernel": "./src/kernel.ts",
        "@std/assert": "jsr:@std/assert@1",
        "@std/cli": "jsr:@std/cli@1",
        "@std/fs": "jsr:@std/fs@1",
        "@std/path": "jsr:@std/path@1",
        "lockness": "./lockness/core/core.ts",
        "@lockness/core": "./lockness/core/core.ts",
        "@lockness/ace": "./lockness/ace/cli.ts",
        "@lockness/drizzle": "./lockness/drizzle/database.ts",
        "hono": "npm:hono@^4.11.1",
        "hono/": "npm:/hono@^4.11.1/",
        "drizzle-orm": "npm:drizzle-orm@^0.31.2",
        "drizzle-orm/": "npm:/drizzle-orm@^0.31.2/",
        "drizzle-kit": "npm:drizzle-kit@^0.22.7",
        "postgres": "npm:postgres@^3.4.4",
        "esbuild": "https://deno.land/x/esbuild@v0.21.5/mod.js",
        "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11.0",
        "perf_hooks": "node:perf_hooks",
        "async_hooks": "node:async_hooks",
        "events": "node:events",
        "string_decoder": "node:string_decoder",
        "buffer": "node:buffer",
        "stream": "node:stream",
        "util": "node:util",
        "crypto": "node:crypto",
        "fs": "node:fs",
        "path": "node:path",
        "net": "node:net",
        "os": "node:os",
        "tls": "node:tls",
        "dns": "node:dns",
        "process": "node:process",
        "querystring": "node:querystring",
        "url": "node:url",
        "zlib": "node:zlib",
        "http": "node:http",
        "https": "node:https"
    },

    "unstable": [
        "kv"
    ],
    "fmt": {
        "indentWidth": 4,
        "useTabs": false,
        "singleQuote": true,
        "proseWrap": "always",
        "lineWidth": 80,
        "semiColons": false
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "hono/jsx"
    }
}
