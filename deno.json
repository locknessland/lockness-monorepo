{
    "tasks": {
        "start": "deno run --allow-net main.ts",
        "dev": "deno run -A --watch main.ts"
    },
    "imports": {
        "@lockness/core": "./lockness-core/lockness.ts",
        "@hono/hono": "jsr:@hono/hono@^4",
        "@hono/hono/": "jsr:@hono/hono@^4/",
        "@std/assert": "jsr:@std/assert@1"
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "hono/jsx"
    },
    "fmt": {
        "indentWidth": 4,
        "useTabs": false,
        "singleQuote": true,
        "proseWrap": "always",
        "lineWidth": 80,
        "semiColons": false
    }
}
