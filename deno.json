{
    "tasks": {
        "start": "deno run --allow-net main.ts",
        "dev": "deno run --watch main.ts"
    },
    "imports": {
        "hono": "jsr:@hono/hono@^4.7.2",
        "@std/assert": "jsr:@std/assert@1"
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "hono/jsx"
    },
    "fmt": {
        "indentWidth": 4,
        "useTabs": false,
        "singleQuote": true,
        "proseWrap": "always",
        "lineWidth": 80,
        "semiColons": true
    }
}
