{
    "tasks": {
        "start": "deno run --allow-net --allow-env main.ts",
        "dev": "deno run --env-file=.env -A --watch main.ts"
    },
    "imports": {
        "@lockness/core": "./lockness-core/lockness.ts",
        "@lockness/bootstrap": "./src/bootstrap.ts",
        "@lockness/hono": "./lockness-core/hono.ts",
        "@lockness/decorators": "./lockness-core/decorators.ts",
        "@hono/hono": "jsr:@hono/hono@^4",
        "@hono/hono/": "jsr:@hono/hono@^4/",
        "@std/assert": "jsr:@std/assert@1",
        "reflect-metadata": "npm:reflect-metadata@0.2.1"
    },
    "fmt": {
        "indentWidth": 4,
        "useTabs": false,
        "singleQuote": true,
        "proseWrap": "always",
        "lineWidth": 80,
        "semiColons": false
    },
    "compilerOptions": {
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    }
}
